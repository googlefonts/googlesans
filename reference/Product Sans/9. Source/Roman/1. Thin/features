feature calt {
    
    lookup Logo_G {
        sub g' o' o' g l e underscore l o g o underscore t e x t by G.logo;
    } Logo_G;
    
    lookup Logo_o_one {
        sub G.logo g' l' e' underscore l o g o underscore t e x t by o.logo;
    } Logo_o_one;
    
    lookup Logo_o_two {
        sub G.logo o.logo underscore' l o g o underscore t e x t by o.logo;
    } Logo_o_two;
    
    lookup Logo_g {
        sub G.logo o.logo o.logo l' o' g' o' underscore t e x t by g.logo;
    } Logo_g;
    
    lookup Logo_l {
        sub G.logo o.logo o.logo g.logo underscore' t e x t by l.logo;
    } Logo_l;
    
    lookup Logo_e {
        sub G.logo o.logo o.logo g.logo l.logo t' e' x' t' by e.logo;
    } Logo_e;
    
    lookup multiply {
        sub @multiply x' @multiply by multiply;
        sub @multiply [space uni00A0] x' [space uni00A0] @multiply by multiply;
    } multiply;

    lookup final_replacements {
        # Degrees
        sub degree C by uni2103;
        sub degree c by uni2103;
        sub degree F by uni2109;
        sub degree f by uni2109;
        sub ordmasculine C by uni2103;
        sub ordmasculine c by uni2103;
        sub ordmasculine F by uni2109;
        sub ordmasculine f by uni2109;

        # Google logo
        sub g o o g l e underscore l o g o by Google.logo;
        sub g o o g l e underscore G by uniF8FF;
        sub g o o g l e underscore g by uniF8FF;
    } final_replacements;
} calt;

