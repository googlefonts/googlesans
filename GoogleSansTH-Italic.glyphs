{
code = "lookup ccmp_Other_1 {
	@CombiningTopAccents = [acutecomb brevecomb caroncomb circumflexcomb commaturnedabovecomb dieresiscomb dotaccentcomb gravecomb hookabovecomb hungarumlautcomb macroncomb ringcomb tildecomb];
	@CombiningNonTopAccents = [brevebelowcomb cedillacomb dieresisbelowcomb dotbelowcomb macronbelowcomb ogonekcomb horncomb];
	sub [i j]' @CombiningTopAccents by [idotless jdotless];
	sub [i j]' @CombiningNonTopAccents @CombiningTopAccents by [idotless jdotless];
	@Markscomb = [tonos psilivaria perispomeni oxia varia dialytikaperispomeni dialytikaoxia dialytikavaria dasiaperispomeni psiliperispomeni psili koronis dasia dasiavaria psilioxia dasiaoxia];
	@MarkscombCase = [tonos.case psilivaria.case perispomeni.case oxia.case varia.case dialytikaperispomeni.case dialytikaoxia.case dialytikavaria.case dasiaperispomeni.case psiliperispomeni.case psili.case koronis.case dasia.case dasiavaria.case psilioxia.case dasiaoxia.case];
	sub @Markscomb @Markscomb' by @MarkscombCase;
	sub @Uppercase @Markscomb' by @MarkscombCase;
} ccmp_Other_1;

lookup ccmp_Other_2 {
	sub @Markscomb' @MarkscombCase by @MarkscombCase;
	sub @MarkscombCase @Markscomb' by @MarkscombCase;
} ccmp_Other_2;

