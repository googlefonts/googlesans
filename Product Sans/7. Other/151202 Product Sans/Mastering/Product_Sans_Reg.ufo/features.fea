feature frac { # Fraction
	# Default
	# Numeral Fraction Numeral
  sub one fraction two by onehalf;
	sub one fraction three by onethird;
	sub one fraction four by onequarter;
  sub one fraction eight by oneeighth;
  sub two fraction three by twothirds;
  sub three fraction four by threequarters;
  sub three fraction eight by threeeighths;
  sub five fraction eight by fiveeighths;
  sub seven fraction eight by seveneighths;
  # Stylistic Alternates
  sub one.alt fraction two by onehalf;
	sub one.alt fraction three by onethird;
	sub one.alt fraction four by onequarter;
  sub one.alt fraction eight by oneeighth;
  sub seven.alt fraction eight by seveneighths;
  # Numeral Slash Numeral
  sub one slash two by onehalf;
	sub one slash three by onethird;
	sub one slash four by onequarter;
  sub one slash eight by oneeighth;
  sub two slash three by twothirds;
  sub three slash four by threequarters;
  sub three slash eight by threeeighths;
  sub five slash eight by fiveeighths;
  sub seven slash eight by seveneighths;
  # Stylistic Alternates
  sub one.alt slash two by onehalf;
	sub one.alt slash three by onethird;
	sub one.alt slash four by onequarter;
  sub one.alt slash eight by oneeighth;
  sub seven.alt slash eight by seveneighths;
  # Numerator Fraction Denominator
  sub one.numerator fraction two.denominator by onehalf;
	sub one.numerator fraction three.denominator by onethird;
	sub one.numerator fraction four.denominator by onequarter;
  sub one.numerator fraction eight.denominator by oneeighth;
  sub two.numerator fraction three.denominator by twothirds;
  sub three.numerator fraction four.denominator by threequarters;
  sub three.numerator fraction eight.denominator by threeeighths;
  sub five.numerator fraction eight.denominator by fiveeighths;
  sub seven.numerator fraction eight.denominator by seveneighths;
  # Numerator Slash Denominator
  sub one.numerator slash two.denominator by onehalf;
	sub one.numerator slash three.denominator by onethird;
	sub one.numerator slash four.denominator by onequarter;
  sub one.numerator slash eight.denominator by oneeighth;
  sub two.numerator slash three.denominator by twothirds;
  sub three.numerator slash four.denominator by threequarters;
  sub three.numerator slash eight.denominator by threeeighths;
  sub five.numerator slash eight.denominator by fiveeighths;
  sub seven.numerator slash eight.denominator by seveneighths;
} frac;
feature dnom { # Denominators
	# DEFAULT
	sub @calt1 by @dnom1;
} dnom;
feature numr { # Numerators
	# DEFAULT
	sub @numr1 by @numr2;
} numr;
feature tnum { # Tabular Figures
	# DEFAULT
	sub @tnum1 by @tnum2;
} tnum;
feature case { # Case-Sensitive
	# DEFAULT
	sub @case1 by @case2;
} case;
feature liga { # Ligatures
	# DEFAULT
	sub f f b by f_f_b;
	sub f f h by f_f_h;
	sub f f i by f_f_i;
	sub f f j by f_f_j;
	sub f f j.alt by f_f_j.alt;
	sub f f k by f_f_k;
	sub f f k.alt by f_f_k.alt;
  sub f f l by f_f_l;
  sub f f t by f_f_t;
  sub f f t.alt by f_f_t.alt;
  sub f f by f_f;
  sub f i by f_i;
	sub f j by f_j;
	sub f k by f_k;
	sub f k.alt by f_k.alt;
  sub f l by f_l;
  sub f t by f_t;
  sub r f by r_f;
  sub r t by r_t;
  sub t t by t_t;
  sub t.alt t.alt by t_t.alt;
  sub t f by t_f;
  sub t.alt f by t_f.alt;
} liga;
feature salt { # Stylistic Alternates
	# DEFAULT
	sub @salt1 by @salt2;
} salt;
feature calt { # Contextual Alternates
	# DEFAULT
	# Multiply
	sub @calt1 x' @calt1 by multiply;
  sub @calt1 [space uni00A0] x' [space uni00A0] @calt1 by multiply;
	# lb (pound)
	sub l b period by uni2114;
	# Number
	sub N o period by uni2116;
	# Degrees
	sub degree C by uni2103;
	sub degree c by uni2103;
	sub degree F by uni2109;
	sub degree f by uni2109;
	sub ordmasculine C by uni2103;
	sub ordmasculine c by uni2103;
	sub ordmasculine F by uni2109;
	sub ordmasculine f by uni2109;
	# Prescription
	sub R x by uni211E;
	sub R.alt x by uni211E;
	# Estimated
	sub e s t period by uni212E;
	sub E s t period by uni212E;
	#
	# Circled Digit
	sub parenleft one parenright by uni2780;
	sub parenleft two parenright by uni2781;
	sub parenleft three parenright by uni2782;
	sub parenleft four parenright by uni2783;
	sub parenleft five parenright by uni2784;
	sub parenleft six parenright by uni2785;
	sub parenleft seven parenright by uni2786;
	sub parenleft eight parenright by uni2787;
	sub parenleft nine parenright by uni2788;
	# Circled Digit Alternatives
	sub parenleft one.alt parenright by uni2780;
	sub parenleft six.alt parenright by uni2785;
	sub parenleft seven.alt parenright by uni2786;
	sub parenleft nine.alt parenright by uni2788;
	# Nevative Circled Digit
	sub parenleft parenleft one parenright parenright by uni278A;
	sub parenleft parenleft two parenright parenright by uni278B;
	sub parenleft parenleft three parenright parenright by uni278C;
	sub parenleft parenleft four parenright parenright by uni278D;
	sub parenleft parenleft five parenright parenright by uni278E;
	sub parenleft parenleft six parenright parenright by uni278F;
	sub parenleft parenleft seven parenright parenright by uni2790;
	sub parenleft parenleft eight parenright parenright by uni2791;
	sub parenleft parenleft nine parenright parenright by uni2792;
	# Nevative Circled Digit Alternatives
	sub parenleft parenleft one.alt parenright parenright by uni278A;
	sub parenleft parenleft six.alt parenright parenright by uni278F;
	sub parenleft parenleft seven.alt parenright parenright by uni2790;
	sub parenleft parenleft nine.alt parenright parenright by uni2792;
	#
	# Arrows
	sub less hyphen by uni2190;
	sub bar greater by uni2191;
	sub hyphen greater by uni2192;
	sub bar less by uni2193;
	sub less backslash by uni2196;  
	sub slash greater by uni2197;
	sub less slash by uni2198;
	sub backslash greater by uni2199;
	#
	# Emoticons
	sub colon parenright by uni263A;
	sub colon hyphen parenright by uni263A;
	sub colon parenleft by uni2639;
	sub colon hyphen parenleft by uni2639;
	#
	# Google logo
  sub g o o g l e underscore l o g o by Google.logo;
  sub g o o g l e underscore G by uniF8FF;
  sub g o o g l e underscore g by uniF8FF;
} calt;
