customParameters = (
{
name = fsType;
value = (
);
},
{
name = vendorID;
value = GOOG;
},
{
name = "Don't use Production Names";
value = 0;
},
{
name = trademark;
value = "Google Sans is a trademark of Google.";
},
{
name = unicodeRanges;
value = (
0,
1,
2,
7,
9
);
},
{
name = "Use Typo Metrics";
value = 1;
},
{
name = license;
value = "Google offers many fonts on open source terms. Google Sans is not one of them. Please see google.com/fonts for alternatives.";
},
{
name = note;
value = "# Adjustment notes\012\012- All legacy marks have been made out of components to reduce the repetition in hinting\012- All accent marks have been slightly modified in height and position to align better. This is true in ALL optical sizes\012\012- Numbers (0123456789) (+tf variants) jump at optical size 14 to avoid a form morphing in interim steps (Angled to straight forms), which can look strange.\012\012\012– symbols – fixed minor spacing errors (tabular forms in the period.tf comma.tf colon.tf)\012\012– tcommaaccent.alt had an incorrect form \012– tcedilla.alt was missing. Added in!\012– jdotless.alt jcircumflex.alt added\012– t_f t_f.alt – changed the f terminal to be inline with all of the other f components\012\012";
},
{
name = Axes;
value = (
{
Name = "Optical size";
Tag = opsz;
},
{
Name = Weight;
Tag = wght;
}
);
},
{
name = "Enforce Compatibility Check";
value = 1;
},
{
name = "Use Extension Kerning";
value = 1;
},
{
name = "Use Line Breaks";
value = 1;
}
);
date = "2017-07-06 09:41:44 +0000";
designer = "Jesse Kaczmarek, Colophon Foundry";
familyName = "Google Sans";
featurePrefixes = (
{
code = "languagesystem DFLT dflt;
