feature locl {
    script arab;
    language FAR;
    lookup arabicspace_arabic;
    language KSH;
    lookup arabicspace_arabic;
    language RHG;
    lookup arabicspace_arabic;
    language SND;
    lookup arabicspace_arabic;
    language URD;
