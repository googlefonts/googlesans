    } GUJ_dflt_pres_conjunctHalfForms;

    lookup GUJ_dflt_pres_topMatraLigatures {
        sub reph-gujarati anusvara-gujarati by reph_anusvara-gujarati;
    } GUJ_dflt_pres_topMatraLigatures;

    lookup GUJ_dflt_pres_iMatraVariants {
        sub [iMatra-gujarati]' @GUJ_iMatra_L1 by [iMatra-gujarati.alt01];
        sub [iMatra-gujarati]' @GUJ_iMatra_L3 by [iMatra-gujarati.alt03];
        sub [iMatra-gujarati]' @GUJ_iMatra_L4 by [iMatra-gujarati.alt04];
        sub [iMatra-gujarati]' @GUJ_iMatra_L5 by [iMatra-gujarati.alt05];
    } GUJ_dflt_pres_iMatraVariants;

    lookup GUJ_dflt_pres_iMatraVariants_context_dynamic {
        sub iMatra-gujarati' kh-gujarati ya-gujarati.post by iMatra-gujarati.alt05;
        sub iMatra-gujarati' bh-gujarati ya-gujarati.post by iMatra-gujarati.alt05;
        sub iMatra-gujarati' k-gujarati s-gujarati [pa-gujarati p-gujarati p_ra-gujarati p_ka-gujarati p_tta-gujarati p_ttha-gujarati p_ta-gujarati p_na-gujarati p_pha-gujarati] by iMatra-gujarati.alt05;
        sub iMatra-gujarati' t-gujarati.alt02 [sa-gujarati s-gujarati s_ra-gujarati s_ka-gujarati s_k_ra-gujarati s_t_ra-gujarati s_tha-gujarati s_na-gujarati s_pha-gujarati s_ma-gujarati s_ya-gujarati] by iMatra-gujarati.alt04;
