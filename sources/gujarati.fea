        sub zha-gujarati aaMatra-gujarati by zha_aaMatra-gujarati;
        sub zha-gujarati iiMatra-gujarati by zha_iiMatra-gujarati;
        sub iiMatra-gujarati reph-gujarati by iiMatra_reph-gujarati;
        sub iiMatra-gujarati reph_anusvara-gujarati by iiMatra_reph_anusvara-gujarati;
    } GUJ_dflt_psts_postBaseLigatures;

    lookup GUJ_dflt_psts_jaVowelLigatures_A {
        sub ja-gujarati' oMatra-gujarati by ja_aaMatra-gujarati;
        sub ja_aaMatra-gujarati oMatra-gujarati' by eMatra-gujarati;
    } GUJ_dflt_psts_jaVowelLigatures_A;

    lookup GUJ_dflt_psts_jaVowelLigatures_B {
        sub ja-gujarati' auMatra-gujarati by ja_aaMatra-gujarati;
        sub ja_aaMatra-gujarati auMatra-gujarati' by aiMatra-gujarati;
    } GUJ_dflt_psts_jaVowelLigatures_B;

    lookup GUJ_dflt_psts_jaVowelLigatures_C {
        sub ja-gujarati' oCandraMatra-gujarati by ja_aaMatra-gujarati;
        sub ja_aaMatra-gujarati oCandraMatra-gujarati' by eCandraMatra-gujarati;
    } GUJ_dflt_psts_jaVowelLigatures_C;

    lookup GUJ_dflt_psts_postBaseYa {
