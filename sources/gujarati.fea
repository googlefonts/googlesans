} pres;

feature abvs {
    script gjr2;
    lookup GUJ_dflt_abvs_dynamicSpacingMatras_decompose {
        sub oMatra-gujarati' reph-gujarati by aaMatra-gujarati eMatra-gujarati;
        sub oMatra-gujarati' reph_anusvara-gujarati by aaMatra-gujarati eMatra-gujarati;
        sub auMatra-gujarati' reph-gujarati by aaMatra-gujarati aiMatra-gujarati;
        sub auMatra-gujarati' reph_anusvara-gujarati by aaMatra-gujarati aiMatra-gujarati;
    } GUJ_dflt_abvs_dynamicSpacingMatras_decompose;

    lookup GUJ_dflt_abvs_aboveVowelLigatures {
        sub eMatra-gujarati reph-gujarati by eMatra_reph-gujarati;
        sub eMatra-gujarati reph_anusvara-gujarati by eMatra_reph_anusvara-gujarati;
        sub aiMatra-gujarati reph-gujarati by aiMatra_reph-gujarati;
        sub aiMatra-gujarati reph_anusvara-gujarati by aiMatra_reph_anusvara-gujarati;
    } GUJ_dflt_abvs_aboveVowelLigatures;

    lookup GUJ_dflt_abvs_shorterTopMatras {
        sub @GUJ_shortTopMatras reph-gujarati' by reph-gujarati.alt01;
        sub @GUJ_shortTopMatras reph_anusvara-gujarati' by reph_anusvara-gujarati.alt01;
        sub @GUJ_shortTopMatras eMatra-gujarati' by eMatra-gujarati.alt01;
        sub @GUJ_shortTopMatras eMatra_reph-gujarati' by eMatra_reph-gujarati.alt01;
        sub @GUJ_shortTopMatras eMatra_reph_anusvara-gujarati' by eMatra_reph_anusvara-gujarati.alt01;
        sub @GUJ_shortTopMatras aiMatra-gujarati' by aiMatra-gujarati.alt01;
        sub @GUJ_shortTopMatras aiMatra_reph-gujarati' by aiMatra_reph-gujarati.alt01;
        sub @GUJ_shortTopMatras aiMatra_reph_anusvara-gujarati' by aiMatra_reph_anusvara-gujarati.alt01;
    } GUJ_dflt_abvs_shorterTopMatras;

} abvs;

feature blws {
    script gjr2;
    lookup GUJ_dflt_blws_consonantVowelLigatures {
        sub ra-gujarati uMatra-gujarati by ra_uMatra-gujarati;
        sub ra-gujarati uuMatra-gujarati by ra_uuMatra-gujarati;
        sub da-gujarati rVocalicMatra-gujarati by da_rVocalicMatra-gujarati;
        sub ha-gujarati rVocalicMatra-gujarati by ha_rVocalicMatra-gujarati;
    } GUJ_dflt_blws_consonantVowelLigatures;

    lookup GUJ_dflt_blws_alternateUMatra {
        sub @GUJ_alternate_uMatra_bases uMatra-gujarati' by uMatra-gujarati.alt02;
        sub @GUJ_alternate_uMatra_bases uuMatra-gujarati' by uuMatra-gujarati.alt01;
    } GUJ_dflt_blws_alternateUMatra;

} blws;

feature psts {
    script gjr2;
    lookup GUJ_dflt_psts_postBaseLigatures {
