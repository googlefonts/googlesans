    } GUJ_dflt_psts_dyn_rVocalicMatra_LD_A;

    lookup GUJ_dflt_psts_dyn_rVocalicMatra_LD_B {
        sub [@GUJ_straightConnection_long] aaMatra-gujarati.segment.alt02 rVocalicMatra-gujarati' by rVocalicMatra-gujarati.alt01;
    } GUJ_dflt_psts_dyn_rVocalicMatra_LD_B;

    lookup GUJ_dflt_psts_dyn_rVocalicMatra_LD_C {
        sub [@GUJ_straightConnection_long @GUJ_straightConnection_long_altuMatra] aaMatra-gujarati.segment.alt02 rrVocalicMatra-gujarati' by rrVocalicMatra-gujarati.alt01;
    } GUJ_dflt_psts_dyn_rVocalicMatra_LD_C;

    # -------------------------------------------
    # Long Kana connection with below-base Rakaar
    # -------------------------------------------
    lookup GUJ_dflt_psts_dyn_JNYa_rakaar_A {
        sub [j_nya-gujarati] [@GUJ_all_vanaanks]' [rakar-gujarati] by aaMatra-gujarati.segment.alt02;
    } GUJ_dflt_psts_dyn_JNYa_rakaar_A;

} psts;
