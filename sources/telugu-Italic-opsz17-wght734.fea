feature blwm {
# Automatic Code End

# ----------------
# Text Bold Italic
# ----------------

markClass [kha-telugu.below] <anchor -421 0> @mark_vattu;
markClass [ga-telugu.below] <anchor -277 0> @mark_vattu;
markClass [gha-telugu.below] <anchor -476 0> @mark_vattu;
