feature locl {
    script arab;
    language FAR;
    lookup arabicspace_arabic;
    language KSH;
    lookup arabicspace_arabic;
    language RHG;
    lookup arabicspace_arabic;
    language SND;
    lookup arabicspace_arabic;
    language URD;
    lookup arabicspace_arabic;
    language dflt;
    lookup arabicspace_arabic;
} locl;

# Give automatic code a place to live; Arabic declares these features so we need
# to give the generated code a placeholder so it still gets made
feature mark {
	# Automatic Code
} mark;

feature mkmk {
	# Automatic Code
} mkmk;
