feature ccmp {
    # generates ethiopic numbers with connected upper and lower bars
    script ethi;
    lookup ethi_ccmp_0 {
        sub @ethi_num @ethi_num' lookup ethi_medi @ethi_num;
        sub @ethi_num_medi @ethi_num' lookup ethi_medi @ethi_num;
    } ethi_ccmp_0;

    lookup ethi_ccmp_1 {
        sub @ethi_num' lookup ethi_init [@ethi_num @ethi_num_medi];
    } ethi_ccmp_1;

    lookup ethi_ccmp_2 {
        sub [@ethi_num_init @ethi_num_medi] @ethi_num' lookup ethi_fina;
    } ethi_ccmp_2;

} ccmp;

feature locl {
    # replaces spaces between ethiopic letters with a wider space than the default Latin wordspace
    script ethi;
    language dflt;
    lookup ethi_guillemet {
        sub [guillemetleft guillemetright guilsinglleft guilsinglright] by [guillemetleft.cap guillemetright.cap guilsinglleft.cap guilsinglright.cap];
    } ethi_guillemet;

    lookup ethi_space {
        lookupflag IgnoreMarks;
        sub @ethi_chars space' @ethi_chars by space.ethi;
        sub @ethi_chars @ethi_punct space' @ethi_chars by space.ethi;
        sub @ethi_chars @ethi_punct @ethi_punct space' @ethi_chars by space.ethi;
        sub @ethi_chars space' @ethi_punct @ethi_chars by space.ethi;
        sub @ethi_chars @ethi_punct space' @ethi_punct @ethi_chars by space.ethi;
        sub @ethi_chars @ethi_punct @ethi_punct space' @ethi_punct @ethi_chars by space.ethi;
    } ethi_space;

} locl;
