@ethi_num_init = [one-ethiopic.init two-ethiopic.init three-ethiopic.init four-ethiopic.init five-ethiopic.init six-ethiopic.init seven-ethiopic.init eight-ethiopic.init nine-ethiopic.init ten-ethiopic.init twenty-ethiopic.init thirty-ethiopic.init forty-ethiopic.init fifty-ethiopic.init sixty-ethiopic.init seventy-ethiopic.init eighty-ethiopic.init ninety-ethiopic.init hundred-ethiopic.init tenthousand-ethiopic.init];

@ethi_num_medi = [one-ethiopic.medi two-ethiopic.medi three-ethiopic.medi four-ethiopic.medi five-ethiopic.medi six-ethiopic.medi seven-ethiopic.medi eight-ethiopic.medi nine-ethiopic.medi ten-ethiopic.medi twenty-ethiopic.medi thirty-ethiopic.medi forty-ethiopic.medi fifty-ethiopic.medi sixty-ethiopic.medi seventy-ethiopic.medi eighty-ethiopic.medi ninety-ethiopic.medi hundred-ethiopic.medi tenthousand-ethiopic.medi];

@ethi_num_fina = [one-ethiopic.fina two-ethiopic.fina three-ethiopic.fina four-ethiopic.fina five-ethiopic.fina six-ethiopic.fina seven-ethiopic.fina eight-ethiopic.fina nine-ethiopic.fina ten-ethiopic.fina twenty-ethiopic.fina thirty-ethiopic.fina forty-ethiopic.fina fifty-ethiopic.fina sixty-ethiopic.fina seventy-ethiopic.fina eighty-ethiopic.fina ninety-ethiopic.fina hundred-ethiopic.fina tenthousand-ethiopic.fina];


