lookup smcp_NOR_localeng {
    sub [eng eng.sc] by eng.alt.sc;
} smcp_NOR_localeng;

# This lookup needs to be after the main contents of both c2sc and smcp
# so that it happens after the small caps have been intruduced.
lookup c2sc_smcp_combining_sc {
    sub @SmallCaps [@latn_CombiningTopAccents @latn_CombiningTopAccents_cap]' by [@latn_CombiningTopAccents_sc @latn_CombiningTopAccents_sc];
    sub @SmallCaps @latn_CombiningTopAccents_sc [@latn_CombiningTopAccents @latn_CombiningTopAccents_cap]' by [@latn_CombiningTopAccents_sc @latn_CombiningTopAccents_sc];
    sub @SmallCaps @latn_CombiningNonTopAccents [@latn_CombiningTopAccents @latn_CombiningTopAccents_cap]' by [@latn_CombiningTopAccents_sc @latn_CombiningTopAccents_sc];
    sub @SmallCaps @latn_CombiningNonTopAccents @latn_CombiningTopAccents_sc [@latn_CombiningTopAccents @latn_CombiningTopAccents_cap]' by [@latn_CombiningTopAccents_sc @latn_CombiningTopAccents_sc];
} c2sc_smcp_combining_sc;

feature c2sc {
    lookup c2sc_letters;
    lookup c2sc_smcp_combining_sc;
    lookup armn_c2sc_substitution;
} c2sc;

feature smcp {
    lookup smcp_letters;
    lookup c2sc_smcp_combining_sc;
    lookup armn_smcp_substitution;
    lookup armn_smcp_contextual_substitution;
    script latn;
    language ISM;
    lookup smcp_NOR_localeng;
    language LSM;
    lookup smcp_NOR_localeng;
    language NSM;
    lookup smcp_NOR_localeng;
    language SKS;
    lookup smcp_NOR_localeng;
} smcp;

feature dlig {
    # ===============
    # BEGIN LATIN
    # ===============
    sub f f b by f_f_b;
    sub f f h by f_f_h;
    sub f f j by f_f_j;
    sub f f k by f_f_k;
    sub f f t by f_f_t;
    sub f b by f_b;
    sub f h by f_h;
    sub f i by f_i;
    sub f j by f_j;
    sub f k by f_k;
    sub f l by f_l;
    sub f t by f_t;
    sub t f by t_f;
    sub t t by t_t;
    ignore sub @grk_UPPERCASE kappa' alpha' iota', kappa' alpha' iota' @grk_UPPERCASE;
    ignore sub @grk_lowercase kappa' alpha' iota', kappa' alpha' iota' @grk_lowercase;
    ignore sub @grk_smallcaps kappa' alpha' iota', kappa' alpha' iota' @grk_smallcaps;
    sub [space hyphen softhyphen endash emdash underscore] kappa' alpha' iota' [space hyphen softhyphen endash emdash underscore] by kaiSymbol;
    sub [space hyphen.cap endash.cap emdash.cap] Kappa' Alpha' Iota' [space hyphen.cap endash.cap emdash.cap] by KaiSymbol;
    sub [space hyphen softhyphen endash emdash underscore] kappa.sc' alpha.sc' iota.sc' [space hyphen softhyphen endash emdash underscore] by kaiSymbol.sc;
    # ===============
    # END LATIN
    # ===============
    # ===============
    # BEGIN HEBREW
    # ===============
    lookup hb_yiddish {
        lookupflag IgnoreMarks;
        sub alef-hb lamed-hb by aleflamed-hb;
        sub vav-hb vav-hb by vavvav-hb;
        sub vav-hb yod-hb by vavyod-hb;
        sub yod-hb yod-hb by yodyod-hb;
    } hb_yiddish;

    # ===============
    # END HEBREW
    # ===============
} dlig;

feature calt {
    sub [G g] o o g l e underscore l o g o by Google.logo;
    sub g o o g l e underscore [G g] by G.logo;
    sub s u p e r underscore [G g] underscore l o g o by G.super;
    sub G underscore l o g o by G.logo;
    sub e underscore l o g o by e.logo;
    sub g underscore l o g o by g.logo;
    sub l underscore l o g o by l.logo;
    sub o underscore l o g o by o.logo;
    sub [space hyphen nbspace endash emdash underscore] etatonos.sc' [space hyphen nbspace endash emdash underscore comma] by etatonos.sc.ss06;
    sub [zero one two three four five six seven eight nine] colon' [zero one two three four five six seven eight nine] by colon.time;
    sub [zero.tf one.tf two.tf three.tf four.tf five.tf six.tf seven.tf eight.tf nine.tf] colon.tf' [zero.tf one.tf two.tf three.tf four.tf five.tf six.tf seven.tf eight.tf nine.tf] by colon.time.tf;
    lookup armn_calt_ligatures;
    lookup armn_calt_contextual_substitution;
    lookup armn_calt_now_with_uppercase;
    lookup armn_calt_shift_punctuation;
} calt;


feature jalt {
    # ===============
    # BEGIN HEBREW
    # ===============
    sub alef-hb by widealef-hb;
    sub he-hb by widehe-hb;
    sub lamed-hb by widelamed-hb;
    sub dalet-hb by widedalet-hb;
    sub kaf-hb by widekaf-hb;
    sub finalmem-hb by finalwidemem-hb;
    sub resh-hb by wideresh-hb;
    sub tav-hb by widetav-hb;
    # ===============
    # END HEBREW
    # ===============
} jalt;

# Stylistic sets

feature ss01 {
    featureNames {
        name "Number Pad Asterisk";
        name 1 "Number Pad Asterisk";
    };

    sub asterisk by asterisk.num;
} ss01;

feature ss02 {
    featureNames {
        name "Colon Time";
        name 1 "Colon Time";
    };

    sub colon by colon.time;
    sub colon.tf by colon.time.tf;    
} ss02;

# Note: ss03 defined in family_uprights.fea feature file

feature ss04 {
    featureNames {
        name "File Size Units";
        name 1 "File Size Units";
    };
    sub B by b.sc.ss04;
    sub E by e.sc.ss04;
    sub G by g.sc.ss04;
    sub K by k.sc.ss04;
    sub M by m.sc.ss04;
    sub P by p.sc.ss04;
    sub T by t.sc.ss04;
    sub k by k.sc.lc.ss04;
} ss04;

feature ss05 {
    featureNames {
        name "Alternate Arrows";
        name 1 "Alternate Arrows";
    };

    sub upArrow by upArrow.ss05;
    sub northEastArrow by northEastArrow.ss05;
    sub rightArrow by rightArrow.ss05;
    sub southEastArrow by southEastArrow.ss05;
    sub downArrow by downArrow.ss05;
    sub southWestArrow by southWestArrow.ss05;
    sub leftArrow by leftArrow.ss05;
    sub northWestArrow by northWestArrow.ss05;
} ss05;

