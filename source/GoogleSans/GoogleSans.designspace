<?xml version='1.0' encoding='UTF-8'?>
<designspace format="5.0">
  <axes elidedfallbackname="Regular">
    <axis tag="opsz" name="Optical Size" minimum="17" maximum="18" default="18">
      <map input="17" output="17"/>
      <map input="17.99" output="17.1"/>
      <map input="18" output="18"/>
      <labels>
        <!-- Max opsz, use elided name of "Google Sans" without opsz identifier -->
        <label uservalue="18" userminimum="18" name="Max" elidable="true"/>
        <label uservalue="17" userminimum="6" usermaximum="17" name="Text"/>
      </labels>
    </axis>
    <axis tag="wght" name="Weight" minimum="400" maximum="700" default="400">
      <map input="400" output="380"/>
      <map input="500" output="555"/>
      <map input="700" output="734"/>
      <labels>
        <label uservalue="400" name="Regular" elidable="true"/>
        <label uservalue="500" name="Medium"/>
        <label uservalue="700" name="Bold"/>
      </labels>
    </axis>
    <axis tag="GRAD" name="Grade" minimum="-50" maximum="200" default="0">
      <labels>
        <label uservalue="-50" name="Grade-50"/>
        <label uservalue="0" name="0" elidable="true"/>
        <label uservalue="200" name="Grade200"/>
      </labels>
    </axis>
    <axis tag="ital" name="Italic" values="0 1" default="0">
      <labels>
        <label uservalue="0" name="Regular" elidable="true" linkeduservalue="1"/>
        <label uservalue="1" name="Italic"/>
      </labels>
    </axis>
  </axes>
