<?xml version='1.0' encoding='UTF-8'?>
<designspace format="4.1">
  <axes>
    <axis tag="opsz" name="Optical size" minimum="17" maximum="18" default="18"/>
    <axis tag="wght" name="Weight" minimum="400" maximum="700" default="400">
      <map input="400" output="380"/>
      <map input="500" output="555"/>
      <map input="700" output="734"/>
    </axis>
    <axis tag="GRAD" name="Grade" minimum="-50" maximum="200" default="0"/>
  </axes>
  <rules>
    <rule name="BRACKET.18.18">
      <conditionset>
        <condition name="Optical size" minimum="18" maximum="18"/>
      </conditionset>
      <sub name="finalpe-hb" with="finalpe-hb.BRACKET.18"/>
      <sub name="finalpedagesh-hb" with="finalpedagesh-hb.BRACKET.18"/>
      <sub name="pe-hb" with="pe-hb.BRACKET.18"/>
      <sub name="pedagesh-hb" with="pedagesh-hb.BRACKET.18"/>
      <sub name="perafe-hb" with="perafe-hb.BRACKET.18"/>
      <sub name="samekh-hb" with="samekh-hb.BRACKET.18"/>
      <sub name="samekhdagesh-hb" with="samekhdagesh-hb.BRACKET.18"/>
    </rule>
  </rules>
