feature abvs {
    script dev2;
    lookup dev2_dflt_mar_nep_abvs_top_mark_ligatures {
        lookupflag 0;
        #	ignore sub ra-deva eMatra-deva anusvara-deva;
        sub eMatra-deva anusvara-deva by eMatra_anusvara-deva;
        sub eMatra-deva candraBindu-deva by eMatra_candraBindu-deva;
        sub eMatra-deva reph-deva by eMatra_reph-deva;
        sub eMatra-deva reph-deva anusvara-deva by eMatra_reph_anusvara-deva;
        sub aiMatra-deva anusvara-deva by aiMatra_anusvara-deva;
        sub aiMatra-deva candraBindu-deva by aiMatra_candraBindu-deva;
        sub aiMatra-deva reph-deva by aiMatra_reph-deva;
        sub aiMatra-deva reph-deva anusvara-deva by aiMatra_reph_anusvara-deva;
        sub eCandraMatra-deva anusvara-deva by eCandraMatra_anusvara-deva;
        sub eCandraMatra-deva reph-deva by eCandraMatra_reph-deva;
        sub eShortMatra-deva anusvara-deva by eShortMatra_anusvara-deva;
        sub eShortMatra-deva candraBindu-deva by eShortMatra_candraBindu-deva;
        sub eShortMatra-deva reph-deva by eShortMatra_reph-deva;
        sub eShortMatra-deva reph-deva anusvara-deva by eShortMatra_reph_anusvara-deva;
        sub reph-deva anusvara-deva by reph_anusvara-deva;
        sub iiMatra-deva reph-deva by iiMatra_reph-deva;
        sub iiMatra-deva.alt2 reph-deva by iiMatra_reph-deva.alt2;
        sub iiMatra-deva reph-deva anusvara-deva by iiMatra_reph_anusvara-deva;
        sub iiMatra-deva.alt2 reph-deva anusvara-deva by iiMatra_reph_anusvara-deva.alt2;
    } dev2_dflt_mar_nep_abvs_top_mark_ligatures;

    lookup dev2_dflt_abvs_replaceCompositeMatras_top {
        sub aCandra-deva' lookup a_vowel anusvara-deva' lookup eCandra_anusvara;
        sub aShort-deva' lookup a_vowel anusvara-deva' lookup eShortMatra_anusvara;
        sub ai-deva' lookup e_vowel anusvara-deva' lookup eMatra_anusvara;
        sub eCandra-deva' lookup e_vowel anusvara-deva' lookup eCandra_anusvara;
        sub eShort-deva' lookup e_vowel anusvara-deva' lookup eShortMatra_anusvara;
        sub o-deva' lookup aa_vowel anusvara-deva' lookup eMatra_anusvara;
        sub au-deva' lookup aa_vowel anusvara-deva' lookup aiMatra_anusvara;
        sub oCandra-deva' lookup aa_vowel anusvara-deva' lookup eCandra_anusvara;
        sub oShort-deva' lookup aa_vowel anusvara-deva' lookup eShortMatra_anusvara;
        sub ii-deva' lookup i_vowel anusvara-deva' lookup reph_anusvara;
        sub oMatra-deva' lookup aa_matra_vowel anusvara-deva' lookup eMatra_anusvara;
        sub auMatra-deva' lookup aa_matra_vowel anusvara-deva' lookup aiMatra_anusvara;
        sub oCandraMatra-deva' lookup aa_matra_vowel anusvara-deva' lookup eCandra_anusvara;
        sub oShortMatra-deva' lookup aa_matra_vowel anusvara-deva' lookup eShortMatra_anusvara;
        sub oMatra-deva' lookup aa_matra_vowel reph-deva' lookup eMatra_reph;
        sub auMatra-deva' lookup aa_matra_vowel reph-deva' lookup aiMatra_reph;
        sub oCandraMatra-deva' lookup aa_matra_vowel reph-deva' lookup eCandra_reph;
        sub oShortMatra-deva' lookup aa_matra_vowel reph-deva' lookup eShortMatra_reph;
        sub oMatra-deva' lookup aa_matra_vowel reph_anusvara-deva' lookup eMatra_reph_anusvara;
        sub auMatra-deva' lookup aa_matra_vowel reph_anusvara-deva' lookup aiMatra_reph_anusvara;
        sub oShortMatra-deva' lookup aa_matra_vowel reph_anusvara-deva' lookup eShortMatra_reph_anusvara;
    } dev2_dflt_abvs_replaceCompositeMatras_top;

    language MAR;
    lookup dev2_dflt_mar_nep_abvs_top_mark_ligatures;
    lookup dev2_dflt_abvs_replaceCompositeMatras_top;
    language NEP;
    lookup dev2_dflt_mar_nep_abvs_top_mark_ligatures;
    lookup dev2_dflt_abvs_replaceCompositeMatras_top;
} abvs;

feature blws {
    script dev2;
    lookup dev2_dflt_mar_nep_blws_botom_mark_ligatures {
        sub ra-deva uMatra-deva by ra_uMatra-deva;
        sub ra-deva uuMatra-deva by ra_uuMatra-deva;
        sub ha-deva uMatra-deva by ha_uMatra-deva;
        sub ha-deva uuMatra-deva by ha_uuMatra-deva;
        sub ha-deva rVocalicMatra-deva by ha_rVocalicMatra-deva;
        sub ha-deva rrVocalicMatra-deva by ha_rrVocalicMatra-deva;
        sub h_ra-deva uMatra-deva by h_ra_uMatra-deva;
        sub h_ra-deva uuMatra-deva by h_ra_uuMatra-deva;
        sub da-deva uMatra-deva by da_uMatra-deva;
        sub da-deva uuMatra-deva by da_uuMatra-deva;
        sub da-deva rVocalicMatra-deva by da_rVocalicMatra-deva;
    } dev2_dflt_mar_nep_blws_botom_mark_ligatures;

    lookup dev2_dflt_mar_nep_blws_short_akhand {
        sub k_ssa-deva' [uMatra-deva uuMatra-deva] by k_ssa-deva.short;
    } dev2_dflt_mar_nep_blws_short_akhand;

    lookup dev2_dflt_mar_nep_blws_rakaar_dynamic_A {
        lookupflag UseMarkFilteringSet [@dev2_UMFS_rakars @dev2_UMFS_nuktas];
        sub kha-deva' rakar-deva by kh-deva.alt5 rakar-deva.diagonal;
        sub gha-deva' rakar-deva by gh-deva.alt2 rakar-deva.diagonal.alt;
        sub ca-deva' rakar-deva by c-deva.alt2 rakar-deva.diagonal.alt;
        sub ja-deva' rakar-deva by j-deva rakar-deva.diagonal;
        sub jha-deva' rakar-deva by jh-deva.alt2 rakar-deva.diagonal;
        sub nna-deva' rakar-deva by nn-deva rakar-deva.diagonal;
        sub ba-deva' rakar-deva by b-deva.alt2 rakar-deva.diagonal;
        sub bha-deva' rakar-deva by bh-deva.alt4 rakar-deva.diagonal;
        sub ma-deva' rakar-deva by m-deva.alt4 rakar-deva.diagonal;
        sub la-deva' rakar-deva by l-deva.alt3 rakar-deva.diagonal;
        sub va-deva' rakar-deva by v-deva.alt2 rakar-deva.diagonal;
        sub ssa-deva' rakar-deva by ss-deva.alt rakar-deva.diagonal.alt;
        sub sa-deva' rakar-deva by s-deva rakar-deva.short;
        sub j_nya-deva' rakar-deva by j_ny-deva.alt2 rakar-deva.diagonal;
        # Nukta glyphs
        sub kha-deva' nukta-deva rakar-deva by kh-deva.alt5 nukta-deva rakar-deva.diagonal;
        sub jha-deva' nukta-deva rakar-deva by jh-deva.alt2 nukta-deva rakar-deva.diagonal;
        sub ja-deva' nukta-deva rakar-deva by j-deva nukta-deva rakar-deva.diagonal;
    } dev2_dflt_mar_nep_blws_rakaar_dynamic_A;

    lookup dev2_dflt_mar_nep_blws_rakaar_dynamic_B {
        lookupflag UseMarkFilteringSet [@dev2_UMFS_rakars @dev2_UMFS_nuktas];
        sub [kh-deva.alt5 b-deva.alt2 bh-deva.alt4 m-deva.alt4 l-deva.alt3] rakar-deva.diagonal rakar-deva' by aaMatra-deva.post;
        sub [j-deva jh-deva.alt2 nn-deva v-deva.alt2] rakar-deva.diagonal rakar-deva' by aaMatra-deva.post.alt;
        sub [jh-deva.alt2] nukta-deva rakar-deva.diagonal nukta-deva' rakar-deva' by aaMatra-deva.post.alt;
        sub [gh-deva.alt2 c-deva.alt2 ss-deva.alt] rakar-deva.diagonal.alt rakar-deva' by aaMatra-deva.post;
        sub s-deva rakar-deva.short rakar-deva' by aaMatra-deva.post;
        sub [kh-deva.alt5 j-deva] nukta-deva rakar-deva.diagonal nukta-deva' rakar-deva' by aaMatra-deva.post.alt;
        sub j_ny-deva.alt2 rakar-deva.diagonal rakar-deva' by aaMatra-deva.post.alt;
    } dev2_dflt_mar_nep_blws_rakaar_dynamic_B;

    lookup dev2_dflt_mar_nep_blws_rakaar_mark {
        lookupflag 0;
        sub @dev2_dflt_blws_rakar_diagonal_bases rakar-deva' by rakar-deva.diagonal;
        sub @dev2_dflt_blws_rakar_diagonal_short_bases rakar-deva' by rakar-deva.short;
        sub [ga-deva tha-deva] rakar-deva' by rakar-deva.diagonal.alt;
    } dev2_dflt_mar_nep_blws_rakaar_mark;

    lookup dev2_dflt_dflt_blws_iMatraForDynamicRakaars {
        lookupflag UseMarkFilteringSet @dev2_dflt_pres_mark_attachment_class_top_marks;
        # Rakaar contexts short
        # Rakaar contexts default
        ignore sub iMatra-deva' j_ny-deva.alt2 aaMatra-deva.post.alt @dev2_dflt_pres_mark_attachment_class_top_marks;
        sub iMatra-deva' j_ny-deva.alt2 aaMatra-deva.post.alt by iMatra-deva.alt5;
    } dev2_dflt_dflt_blws_iMatraForDynamicRakaars;

    lookup dev2_dflt_blws_decomposeNuktaGlyphsWithRakaar_A {
        lookupflag 0;
        sub [ka-deva pha-deva ya-deva] nukta-deva rakar-deva' by rakar-deva.diagonal nukta-deva;
        sub [dddha-deva rha-deva] rakar-deva' by rakar_nukta-deva;
    } dev2_dflt_blws_decomposeNuktaGlyphsWithRakaar_A;

    lookup dev2_dflt_blws_decomposeNuktaGlyphsWithRakaar_B {
        sub [ka-deva pha-deva ya-deva] nukta-deva' rakar-deva.diagonal nukta-deva by NULL;
        sub dddha-deva' rakar_nukta-deva by dda-deva;
        sub rha-deva' rakar_nukta-deva by ddha-deva;
    } dev2_dflt_blws_decomposeNuktaGlyphsWithRakaar_B;

    lookup dev2_dflt_blws_decomposeNuktaGlyphsWithRakaar_C {
        sub [ka-deva pha-deva ya-deva] rakar-deva.diagonal nukta-deva uMatra-deva' by uMatra-deva nukta-deva;
        sub [ka-deva pha-deva ya-deva] rakar-deva.diagonal nukta-deva uuMatra-deva' by uuMatra-deva nukta-deva;
    } dev2_dflt_blws_decomposeNuktaGlyphsWithRakaar_C;

    lookup dev2_dflt_blws_decomposeNuktaGlyphsWithRakaar_D {
        sub [ka-deva pha-deva ya-deva] rakar-deva.diagonal nukta-deva' [uMatra-deva uuMatra-deva] nukta-deva by NULL;
    } dev2_dflt_blws_decomposeNuktaGlyphsWithRakaar_D;

    lookup dev2_dflt_mar_nep_blws_umatra_short {
        sub [tt_tta-deva tt_ttha-deva tth_ttha-deva dd_dda-deva dd_ddha-deva ddh_ddha-deva nga-deva cha-deva tta-deva ttha-deva dda-deva ddha-deva lla-deva llla-deva gga-deva jja-deva ddda-deva bba-deva la-deva.loclMAR ng_ga-deva d_ga-deva d_gha-deva d_da-deva d_dha-deva d_ba-deva d_bha-deva d_ra-deva d_va-deva h_ra-deva h_la-deva h_va-deva h_nna-deva h_na-deva] [uMatra-deva uuMatra-deva]' by [uMatra-deva.alt uuMatra-deva.alt];
        sub [rakar-deva rakar_nukta-deva] [uMatra-deva uuMatra-deva]' by [uMatra-deva.alt uuMatra-deva.alt];
    } dev2_dflt_mar_nep_blws_umatra_short;

    lookup dev2_dflt_blws_umatra_narrow {
        lookupflag UseMarkFilteringSet [@dev2_UMFS_rakars @dev2_UMFS_uMatras];
        #lookupflag UseMarkFilteringSet ;
        sub [jh-deva.alt2 j_ny-deva.alt2] [rakar-deva.diagonal] [aaMatra-deva.post.alt] uMatra-deva' by uMatra-deva.narrow;
        sub [tha-deva] [rakar-deva.diagonal.alt] uMatra-deva' by uMatra-deva.narrow;
        sub [ka-deva dha-deva pha-deva ya-deva] [rakar-deva.diagonal] uMatra-deva' by uMatra-deva.narrow;
        sub [jha-deva k_ss_ra-deva h_ma-deva h_ya-deva j_nya-deva] uMatra-deva' by uMatra-deva.narrow;
    } dev2_dflt_blws_umatra_narrow;

    language MAR;
    lookup dev2_mar_blws_umatra_narrow {
        lookupflag UseMarkFilteringSet @dev2_UMFS_uMatras;
        sub sha-deva.loclMAR uMatra-deva' by uMatra-deva.narrow;
    } dev2_mar_blws_umatra_narrow;

    language NEP;
} blws;

feature psts {
    script dev2;
    lookup dev2_dflt_mar_nep_psts_iimatra_alternates {
        sub [ka-deva qa-deva pha-deva fa-deva] rakar-deva.diagonal [iiMatra-deva iiMatra_reph-deva iiMatra_reph_anusvara-deva]' by [iiMatra-deva.alt2 iiMatra_reph-deva.alt2 iiMatra_reph_anusvara-deva.alt2];
        sub [ka-deva qa-deva pha-deva fa-deva] [iiMatra-deva iiMatra_reph-deva iiMatra_reph_anusvara-deva]' by [iiMatra-deva.alt2 iiMatra_reph-deva.alt2 iiMatra_reph_anusvara-deva.alt2];
    } dev2_dflt_mar_nep_psts_iimatra_alternates;

    language MAR;
    lookup dev2_dflt_mar_nep_psts_iimatra_alternates;
    language NEP;
    lookup dev2_dflt_mar_nep_psts_iimatra_alternates;
} psts;

feature rclt {
    script dev2;
    lookup dev2_dflt_mar_nep_rclt_alternate_ematra {
        sub @dev2_dflt_rclt_all_above_matra_ligatures ra-deva eMatra-deva' by eMatra-deva.narrow;
    } dev2_dflt_mar_nep_rclt_alternate_ematra;

    language MAR;
    lookup dev2_dflt_mar_nep_rclt_alternate_ematra;
    language NEP;
    lookup dev2_dflt_mar_nep_rclt_alternate_ematra;
} rclt;

feature tnum {
    script dev2;
    sub @dev2_proportional_numerals by @dev2_tabular_numerals;
    language MAR;
    language NEP;
} tnum;
