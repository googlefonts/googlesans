# ---------------------------------
# Devanagari classes
# ---------------------------------
@dev2_default_punctuation = [period comma colon semicolon ellipsis exclam question asterisk parenleft parenright braceleft braceright bracketleft bracketright quotedblleft quotedblright quoteleft quoteright];

@dev2_localised_punctuation = [period.loclDEVA comma.loclDEVA colon.loclDEVA semicolon.loclDEVA ellipsis.loclDEVA exclam.loclDEVA question.loclDEVA asterisk.loclDEVA parenleft.loclDEVA parenright.loclDEVA braceleft.loclDEVA braceright.loclDEVA bracketleft.loclDEVA bracketright.loclDEVA quotedblleft.loclDEVA quotedblright.loclDEVA quoteleft.loclDEVA quoteright.loclDEVA];

@dev2_proportional_numerals = [zero-deva one-deva two-deva three-deva four-deva five-deva six-deva seven-deva eight-deva nine-deva one-deva.loclNEP five-deva.loclNEP eight-deva.loclMARNEP nine-deva.loclNEP];

@dev2_tabular_numerals = [zero-deva.tf one-deva.tf two-deva.tf three-deva.tf four-deva.tf five-deva.tf six-deva.tf seven-deva.tf eight-deva.tf nine-deva.tf one-deva.loclNEP.tf five-deva.loclNEP.tf eight-deva.loclMARNEP.tf nine-deva.loclNEP.tf];

@dev2_dflt_pres_imatra_alt2_bases = [ra-deva rra-deva marwaridda-deva tt_tta-deva tt_ttha-deva tth_ttha-deva d_da-deva];

@dev2_dflt_pres_imatra_alt3_bases = [ka-deva qa-deva gha-deva nga-deva tta-deva ttha-deva dda-deva ddha-deva ta-deva da-deva dha-deva na-deva nnna-deva pa-deva pha-deva fa-deva va-deva ssa-deva ha-deva dddha-deva rha-deva jha-deva.loclNEP ddda-deva bba-deva dd_dda-deva dd_ddha-deva ddh_ddha-deva t_ra-deva d_ga-deva ss_tta-deva ss_ttha-deva d_ba-deva d_ra-deva d_va-deva h_na-deva h_ra-deva h_va-deva ng_ga-deva];

@dev2_dflt_pres_imatra_dflt_bases = [ga-deva ca-deva cha-deva tha-deva ba-deva bha-deva ma-deva ya-deva sha-deva sa-deva ghha-deva yya-deva yaheavy-deva gga-deva k_ssa-deva j_nya-deva la-deva.loclMAR sha-deva.loclMAR t_ta-deva d_gha-deva d_dha-deva d_bha-deva d_ma-deva d_ya-deva p_ta-deva sh_ra-deva h_nna-deva h_la-deva];

@dev2_dflt_pres_imatra_alt4_bases = [ja-deva jha-deva nya-deva nna-deva la-deva lla-deva llla-deva za-deva jja-deva zha-deva h_ma-deva h_ya-deva];

@dev2_dflt_pres_imatra_alt4_bases_short_A = [ja-deva za-deva jja-deva zha-deva h_ma-deva];

@dev2_dflt_pres_imatra_alt4_bases_short_B = [jha-deva nya-deva nna-deva la-deva lla-deva llla-deva h_ya-deva];

@dev2_dflt_pres_imatra_alt5_bases = [kha-deva khha-deva];

@dev2_dflt_pres_imatra_alt7_bases = [ng_ya-deva ch_ya-deva tt_ya-deva tth_ya-deva dd_ya-deva ddh_ya-deva d_dh_ya-deva];

@dev2_dflt_abvm_imatra_alt1_bases = [ra-deva rra-deva];

@dev2_dflt_rclt_all_above_matra_ligatures = [iiMatra_reph-deva iiMatra_reph-deva.alt2 iiMatra_reph_anusvara-deva iiMatra_reph_anusvara-deva.alt2 eMatra_anusvara-deva eMatra_candraBindu-deva eMatra_reph-deva eMatra_reph_anusvara-deva aiMatra_anusvara-deva aiMatra_candraBindu-deva aiMatra_reph-deva aiMatra_reph_anusvara-deva eCandraMatra_anusvara-deva eCandraMatra_reph-deva eShortMatra_anusvara-deva eShortMatra_candraBindu-deva eShortMatra_reph-deva eShortMatra_reph_anusvara-deva reph_anusvara-deva];

@dev2_dflt_blws_rakar_diagonal_bases = [ka-deva gha-deva ca-deva ja-deva nya-deva nna-deva dha-deva na-deva pa-deva pha-deva ba-deva ya-deva va-deva qa-deva za-deva fa-deva yya-deva jha-deva.loclNEP k-deva k-deva.alt2 k-deva.alt3 k-deva.alt4 k-deva.alt5 k-deva.alt6 k-deva.alt7 k-deva.alt8 k-deva.alt10 k-deva.alt11 g-deva gh-deva gh-deva.alt2 c-deva c-deva.alt2 j-deva j-deva.alt2 j-deva.alt3 j-deva.alt4 j-deva.alt5 j-deva.alt6 j-deva.alt7 j-deva.alt8 ny-deva ny-deva.alt2 nn-deva t-deva t-deva.alt2 t-deva.alt3 t-deva.alt4 th-deva th-deva.alt2 th-deva.alt3 th-deva.alt4 dh-deva dh-deva.alt2 dh-deva.alt3 dh-deva.alt4 n-deva n-deva.alt2 n-deva.alt3 n-deva.alt4 nnn-deva nnn-deva.alt2 nnn-deva.alt3 nnn-deva.alt4 p-deva p-deva.alt2 p-deva.alt3 ph-deva ph-deva.alt2 ph-deva.alt3 ph-deva.alt4 ph-deva.alt5 ph-deva.alt6 ph-deva.alt7 ph-deva.alt8 ph-deva.alt10 ph-deva.alt11 b-deva b-deva.alt2 b-deva.alt3 b-deva.alt4 b-deva.alt5 bh-deva bh-deva.alt2 bh-deva.alt3 bh-deva.alt4 m-deva m-deva.alt2 m-deva.alt3 m-deva.alt4 y-deva y-deva.alt2 y-deva.alt3 v-deva v-deva.alt2 v-deva.alt3 v-deva.alt4 v-deva.alt5 ss-deva ghh-deva yaheavy-deva.half jh-deva.loclNEP jh-deva.loclNEP.alt2];

#zh-deva zh-deva.alt2 zh-deva.alt3 zh-deva.alt4 zh-deva.alt5 zh-deva.alt6 zh-deva.alt7 zh-deva.alt8
@dev2_dflt_blws_rakar_diagonal_short_bases = [ghha-deva j_nya-deva kh-deva kh-deva.alt2 kh-deva.alt3 kh-deva.alt4 jh-deva jh-deva.alt2 jh-deva.alt3 l-deva l-deva.alt2 l-deva.alt3 l-deva.alt4 l-deva.alt5 l-deva.alt6 l-deva.alt7 l-deva.alt8 ghh-deva k_ss-deva k_ss-deva.alt2 k_ss-deva.alt3 k_ss-deva.alt4 k_ss-deva.alt5 k_ss-deva.alt6 k_ss-deva.alt7 j_ny-deva j_ny-deva.alt2 j_ny-deva.alt3 j_ny-deva.alt4 j_ny-deva.alt5 j_ny-deva.alt6 j_ny-deva.alt7 j_ny-deva.alt8];

@dev2_dflt_half_mark_attachment_class_halant = [halant-deva];

@dev2_dflt_pres_mark_attachment_class_top_marks = [anusvara-deva candraBindu-deva reph-deva reph_anusvara-deva];

@dev2_dflt_blws_mark_attachment_class_uMatra = [uMatra-deva uMatra-deva.narrow];

@dev2_UMFS_rakars = [rakar-deva rakar-deva.diagonal rakar-deva.short rakar-deva.diagonal.alt rakar_nukta-deva];

@dev2_UMFS_uMatras = [uMatra-deva uMatra-deva.narrow];

@dev2_UMFS_nuktas = [nukta-deva];

# ---------------------------------
# Lookups
# ---------------------------------

# Prefix: IndependentLookups
lookup dev2_dflt_none_zwj_eyelash_ra {
    sub ra-deva halant-deva zerowidthjoiner by eyelashReph-deva;
} dev2_dflt_none_zwj_eyelash_ra;

#lookup dev2_dflt_none_decompose_nukta_glyphs {
#	sub qa-deva by ka-deva nukta-deva;
#} dev2_dflt_none_decompose_nukta_glyphs;
# ---------------------------------
# Vowels with composite above marks
# ---------------------------------
lookup a_vowel {
    sub [aCandra-deva aShort-deva] by a-deva;
} a_vowel;

lookup e_vowel {
    sub [ai-deva eCandra-deva eShort-deva] by e-deva;
} e_vowel;

lookup aa_vowel {
    sub [o-deva au-deva oCandra-deva oShort-deva] by aa-deva;
} aa_vowel;

lookup i_vowel {
    sub [ii-deva] by i-deva;
} i_vowel;

lookup aa_matra_vowel {
    sub [oMatra-deva auMatra-deva oCandraMatra-deva oShortMatra-deva] by aaMatra-deva;
} aa_matra_vowel;

lookup eMatra_anusvara {
    sub anusvara-deva by eMatra_anusvara-deva;
} eMatra_anusvara;

lookup aiMatra_anusvara {
    sub anusvara-deva by aiMatra_anusvara-deva;
} aiMatra_anusvara;

lookup eCandra_anusvara {
    sub anusvara-deva by eCandraMatra_anusvara-deva;
} eCandra_anusvara;

lookup eShortMatra_anusvara {
    sub anusvara-deva by eShortMatra_anusvara-deva;
} eShortMatra_anusvara;

lookup reph_anusvara {
    sub anusvara-deva by reph_anusvara-deva;
} reph_anusvara;

# ---
lookup eMatra_reph {
    sub reph-deva by eMatra_reph-deva;
} eMatra_reph;

lookup eMatra_reph_anusvara {
    sub reph_anusvara-deva by eMatra_reph_anusvara-deva;
} eMatra_reph_anusvara;

lookup aiMatra_reph {
    sub reph-deva by aiMatra_reph-deva;
} aiMatra_reph;

lookup aiMatra_reph_anusvara {
    sub reph_anusvara-deva by aiMatra_reph_anusvara-deva;
} aiMatra_reph_anusvara;

lookup eCandra_reph {
    sub reph-deva by eCandraMatra_reph-deva;
} eCandra_reph;

lookup eShortMatra_reph {
    sub reph-deva by eShortMatra_reph-deva;
} eShortMatra_reph;

lookup eShortMatra_reph_anusvara {
    sub reph_anusvara-deva by eShortMatra_reph_anusvara-deva;
} eShortMatra_reph_anusvara;

feature locl {
    script dev2;
    lookup dev2_dflt_locl_localised_punctuations {
    	sub @dev2_default_punctuation by @dev2_localised_punctuation;
    } dev2_dflt_locl_localised_punctuations;
    language MAR;
    lookup dev2_mar_locl_localised_consonants {
        sub la-deva by la-deva.loclMAR;
        # Marathi La
        sub sha-deva by sha-deva.loclMAR;
        # Marathi Sha
    } dev2_mar_locl_localised_consonants;

    lookup dev2_mar_nep_locl_common_localised_numerals {
        sub eight-deva by eight-deva.loclMARNEP;
    } dev2_mar_nep_locl_common_localised_numerals;

    language NEP;
    lookup dev2_nep_locl_localised_consonants_numerals {
        sub jha-deva by jha-deva.loclNEP;
        # Nepali Jha
        sub one-deva by one-deva.loclNEP;
        sub five-deva by five-deva.loclNEP;
        sub nine-deva by nine-deva.loclNEP;
    } dev2_nep_locl_localised_consonants_numerals;

    lookup dev2_mar_nep_locl_common_localised_numerals;
} locl;

feature nukt {
    script dev2;
    lookup dev2_dflt_mar_nep_nukt_all_nukta_forms {
        ignore sub [ka-deva kha-deva ja-deva pha-deva ya-deva]' nukta-deva' halant-deva;
        sub ka-deva' nukta-deva' by qa-deva;
        sub ra-deva' nukta-deva' by rra-deva;
        sub lla-deva' nukta-deva' by llla-deva;
        sub kha-deva' nukta-deva' by khha-deva;
        sub ga-deva' nukta-deva' by ghha-deva;
        sub ja-deva' nukta-deva' by za-deva;
        sub dda-deva' nukta-deva' by dddha-deva;
        sub ddha-deva' nukta-deva' by rha-deva;
        sub pha-deva' nukta-deva' by fa-deva;
        sub ya-deva' nukta-deva' by yya-deva;
    } dev2_dflt_mar_nep_nukt_all_nukta_forms;

    language MAR;
    lookup dev2_dflt_mar_nep_nukt_all_nukta_forms;
    language NEP;
    lookup dev2_dflt_mar_nep_nukt_all_nukta_forms;
} nukt;

feature akhn {
    script dev2;
    lookup dev2_dflt_mar_nep_akhn_akhand_forms {
        sub ka-deva halant-deva ssa-deva by k_ssa-deva;
        sub ja-deva halant-deva nya-deva by j_nya-deva;
    } dev2_dflt_mar_nep_akhn_akhand_forms;

    lookup dev2_dflt_akhn_eyelash_reph {
        ignore sub halant-deva ra-deva' halant-deva' zerowidthjoiner';
        sub ra-deva' lookup dev2_dflt_none_zwj_eyelash_ra halant-deva' zerowidthjoiner';
    } dev2_dflt_akhn_eyelash_reph;

    language MAR;
    lookup dev2_dflt_mar_nep_akhn_akhand_forms;
    lookup dev2_dflt_akhn_eyelash_reph;
    language NEP;
    lookup dev2_dflt_mar_nep_akhn_akhand_forms;
    lookup dev2_dflt_akhn_eyelash_reph;
} akhn;

feature rphf {
    script dev2;
    lookup dev2_dflt_mar_nep_rphf_reph {
        sub ra-deva halant-deva by reph-deva;
    } dev2_dflt_mar_nep_rphf_reph;

    language MAR;
    lookup dev2_dflt_mar_nep_rphf_reph;
    language NEP;
    lookup dev2_dflt_mar_nep_rphf_reph;
} rphf;

feature rkrf {
    script dev2;
    lookup dev2_dflt_mar_nep_rkrf_rakar_forms {
        sub da-deva halant-deva ra-deva by d_ra-deva;
        sub ta-deva halant-deva ra-deva by t_ra-deva;
        sub ha-deva halant-deva ra-deva by h_ra-deva;
        sub sha-deva halant-deva ra-deva by sh_ra-deva;
        sub k_ssa-deva halant-deva ra-deva by k_ss_ra-deva;
    } dev2_dflt_mar_nep_rkrf_rakar_forms;

    language MAR;
    lookup dev2_dflt_mar_nep_rkrf_rakar_forms;
    lookup dev2_mar_rkrf_rakar_forms {
        sub sha-deva.loclMAR halant-deva ra-deva by sh_ra-deva;
    } dev2_mar_rkrf_rakar_forms;

    language NEP;
    lookup dev2_dflt_mar_nep_rkrf_rakar_forms;
} rkrf;

feature blwf {
    script dev2;
    lookup dev2_dflt_mar_nep_blwf_rakar_below {
        sub halant-deva ra-deva by rakar-deva;
    } dev2_dflt_mar_nep_blwf_rakar_below;

    language MAR;
    lookup dev2_dflt_mar_nep_blwf_rakar_below;
    language NEP;
    lookup dev2_dflt_mar_nep_blwf_rakar_below;
} blwf;

feature half {
    script dev2;
    lookup dev2_dflt_mar_nep_half_all_half_forms {
        lookupflag MarkAttachmentType @dev2_dflt_half_mark_attachment_class_halant;
        sub ka-deva halant-deva by k-deva;
        sub kha-deva halant-deva by kh-deva;
        sub ga-deva halant-deva by g-deva;
        sub gha-deva halant-deva by gh-deva;
        sub nga-deva halant-deva by ng-deva;
        sub ca-deva halant-deva by c-deva;
        sub cha-deva halant-deva by ch-deva;
        sub ja-deva halant-deva by j-deva;
        sub jha-deva halant-deva by jh-deva;
        sub nya-deva halant-deva by ny-deva;
        sub tta-deva halant-deva by tt-deva;
        sub ttha-deva halant-deva by tth-deva;
        sub dda-deva halant-deva by dd-deva;
        sub ddha-deva halant-deva by ddh-deva;
        sub nna-deva halant-deva by nn-deva;
        sub ta-deva halant-deva by t-deva;
        sub tha-deva halant-deva by th-deva;
        sub da-deva halant-deva by d-deva;
        sub dha-deva halant-deva by dh-deva;
        sub na-deva halant-deva by n-deva;
        sub nnna-deva halant-deva by nnn-deva;
        sub pa-deva halant-deva by p-deva;
        sub pha-deva halant-deva by ph-deva;
        sub ba-deva halant-deva by b-deva;
        sub bha-deva halant-deva by bh-deva;
        sub ma-deva halant-deva by m-deva;
        sub ya-deva halant-deva by y-deva;
        sub rra-deva halant-deva by eyelashReph-deva;
        sub la-deva halant-deva by l-deva;
        sub lla-deva halant-deva by ll-deva;
        sub llla-deva halant-deva by lll-deva;
        sub va-deva halant-deva by v-deva;
        sub sha-deva halant-deva by sh-deva;
        sub ssa-deva halant-deva by ss-deva;
        sub sa-deva halant-deva by s-deva;
        sub ha-deva halant-deva by h-deva;
        sub ghha-deva halant-deva by ghh-deva;
        sub dddha-deva halant-deva by dddh-deva;
        sub rha-deva halant-deva by rh-deva;
        sub yaheavy-deva halant-deva by yaheavy-deva.half;
        sub gga-deva halant-deva by gg-deva;
        sub jja-deva halant-deva by jj-deva;
        sub ddda-deva halant-deva by ddd-deva;
        sub bba-deva halant-deva by bb-deva;
        sub k_ssa-deva halant-deva by k_ss-deva;
        sub j_nya-deva halant-deva by j_ny-deva;
        sub t_ra-deva halant-deva by t_r-deva;
        sub sh_ra-deva halant-deva by sh_r-deva;
    } dev2_dflt_mar_nep_half_all_half_forms;

    lookup dev2_dflt_mar_nep_half_zhaDynamic_A {
        lookupflag 0;
        sub zha-deva halant-deva' by nukta-deva.triple;
    } dev2_dflt_mar_nep_half_zhaDynamic_A;

    lookup dev2_dflt_mar_nep_half_zhaDynamic_B {
        sub zha-deva' nukta-deva.triple by j-deva;
    } dev2_dflt_mar_nep_half_zhaDynamic_B;

    language MAR;
    lookup dev2_dflt_mar_nep_half_all_half_forms;
    lookup dev2_mar_half_marathi_consonant_half_forms {
        lookupflag MarkAttachmentType @dev2_dflt_half_mark_attachment_class_halant;
        sub la-deva.loclMAR halant-deva by l-deva;
        sub sha-deva.loclMAR halant-deva by sh-deva.loclMAR;
    } dev2_mar_half_marathi_consonant_half_forms;

    language NEP;
    lookup dev2_dflt_mar_nep_half_all_half_forms;
    lookup dev2_nep_half_nepali_consonant_half_forms {
        lookupflag MarkAttachmentType @dev2_dflt_half_mark_attachment_class_halant;
        sub jha-deva.loclNEP halant-deva by jh-deva.loclNEP;
    } dev2_nep_half_nepali_consonant_half_forms;

} half;

feature cjct {
    script dev2;
    lookup dev2_dflt_mar_nep_cjct_all_conjuncts {
        lookupflag IgnoreMarks;
        sub ng-deva ga-deva by ng_ga-deva;
        sub ng-deva ya-deva by ng_ya-deva;
        sub ch-deva ya-deva by ch_ya-deva;
        sub tt-deva tta-deva by tt_tta-deva;
        sub tt-deva ttha-deva by tt_ttha-deva;
        sub tt-deva ya-deva by tt_ya-deva;
        sub tth-deva ttha-deva by tth_ttha-deva;
        sub tth-deva ya-deva by tth_ya-deva;
        sub dd-deva dda-deva by dd_dda-deva;
        sub dd-deva ddha-deva by dd_ddha-deva;
        sub dd-deva ya-deva by dd_ya-deva;
        sub ddh-deva ddha-deva by ddh_ddha-deva;
        sub ddh-deva ya-deva by ddh_ya-deva;
        sub d-deva ga-deva by d_ga-deva;
        sub d-deva gha-deva by d_gha-deva;
        sub d-deva da-deva by d_da-deva;
        sub d-deva dha-deva by d_dha-deva;
        sub d-deva ba-deva by d_ba-deva;
        sub d-deva bha-deva by d_bha-deva;
        sub d-deva ma-deva by d_ma-deva;
        sub d-deva ya-deva by d_ya-deva;
        sub d-deva ra-deva by d_ra-deva;
        sub d-deva va-deva by d_va-deva;
        sub d-deva dh-deva ya-deva by d_dh_ya-deva;
        sub h-deva nna-deva by h_nna-deva;
        sub h-deva na-deva by h_na-deva;
        sub h-deva ya-deva by h_ya-deva;
        sub h-deva ma-deva by h_ma-deva;
        sub h-deva la-deva by h_la-deva;
        sub h-deva va-deva by h_va-deva;
    } dev2_dflt_mar_nep_cjct_all_conjuncts;

    language MAR;
    lookup dev2_dflt_mar_nep_cjct_all_conjuncts;
    lookup dev2_mar_cjct_all_conjuncts {
        lookupflag IgnoreMarks;
        sub h-deva la-deva.loclMAR by h_la-deva;
    } dev2_mar_cjct_all_conjuncts;

    language NEP;
    lookup dev2_dflt_mar_nep_cjct_all_conjuncts;
} cjct;

feature pres {
    script dev2;
    lookup dev2_dflt_mar_nep_pres_contextual_half_forms {
        lookupflag IgnoreMarks;
        sub [k-deva]' [cha-deva nga-deva jha-deva dda-deva pa-deva pha-deva ssa-deva ha-deva dddha-deva fa-deva ddda-deva nna-deva bba-deva ch-deva ng-deva jh-deva dd-deva p-deva ph-deva ss-deva h-deva dddh-deva ddd-deva nn-deva bb-deva] by [k-deva.alt2];
        sub [k-deva]' [ga-deva na-deva nnna-deva ghha-deva gga-deva bha-deva jha-deva.loclNEP ma-deva marwaridda-deva g-deva n-deva nnn-deva ghh-deva gg-deva bh-deva m-deva] by [k-deva.alt3];
        sub [k-deva]' [tta-deva ttha-deva ddha-deva ta-deva da-deva rha-deva tt-deva tth-deva ddh-deva t-deva d-deva rh-deva] by [k-deva.alt4];
