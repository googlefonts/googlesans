    # -------
    # Spacing
    # -------
    lookup gur2_dflt_rclt_contextual_kerning_tippi {
        pos u-gurmukhi tippi-gurmukhi.short headline-gurmukhi' <35 0 35 0> [u-gurmukhi uu-gurmukhi ura-gurmukhi];
        pos u-gurmukhi tippi-gurmukhi.short headline-gurmukhi [u-gurmukhi uu-gurmukhi ura-gurmukhi]' <20 0 20 0>;
        pos u-gurmukhi tippi-gurmukhi.short headline-gurmukhi' <35 0 35 0> [i-gurmukhi iMatra-gurmukhi];
        pos u-gurmukhi tippi-gurmukhi.short headline-gurmukhi [i-gurmukhi iMatra-gurmukhi]' <35 0 35 0>;
        pos @gur2_dflt_rclt_wide_consonants auMatra-gurmukhi bindi-gurmukhi headline-gurmukhi' <35 0 35 0> [i-gurmukhi iMatra-gurmukhi];
        pos au-gurmukhi bindi-gurmukhi headline-gurmukhi' <35 0 35 0> [i-gurmukhi iMatra-gurmukhi];
    } gur2_dflt_rclt_contextual_kerning_tippi;

