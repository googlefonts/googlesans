        sub [ee-gurmukhi ai-gurmukhi] adakbindi-gurmukhi' @gur2_dflt_rclt_wide_consonants @gur2_dflt_rclt_all_top_matras by addak-gurmukhi.short bindi-gurmukhi headline-gurmukhi.short;
        sub [ee-gurmukhi ai-gurmukhi] adakbindi-gurmukhi' @gur2_dflt_rclt_short_consonants @gur2_dflt_rclt_all_top_matras by addak-gurmukhi.short bindi-gurmukhi headline-gurmukhi headline-gurmukhi.shorter;
        sub [au-gurmukhi] adakbindi-gurmukhi' @gur2_dflt_rclt_wide_consonants @gur2_dflt_rclt_all_top_matras by addak-gurmukhi.short bindi-gurmukhi headline-gurmukhi;
        sub [au-gurmukhi] adakbindi-gurmukhi' @gur2_dflt_rclt_short_consonants @gur2_dflt_rclt_all_top_matras by addak-gurmukhi.short bindi-gurmukhi headline-gurmukhi headline-gurmukhi;
        sub [ee-gurmukhi ai-gurmukhi] addak-gurmukhi' @gur2_dflt_rclt_wide_consonants @gur2_dflt_rclt_all_top_matras by addak-gurmukhi.short headline-gurmukhi.short;
        sub [ee-gurmukhi ai-gurmukhi] addak-gurmukhi' @gur2_dflt_rclt_short_consonants @gur2_dflt_rclt_all_top_matras by addak-gurmukhi.short headline-gurmukhi headline-gurmukhi.shorter;
        sub au-gurmukhi addak-gurmukhi' @gur2_dflt_rclt_wide_consonants @gur2_dflt_rclt_all_top_matras by addak-gurmukhi.short headline-gurmukhi;
        sub au-gurmukhi addak-gurmukhi' @gur2_dflt_rclt_short_consonants @gur2_dflt_rclt_all_top_matras by addak-gurmukhi.short headline-gurmukhi headline-gurmukhi;
        sub [ee-gurmukhi ai-gurmukhi] adakbindi-gurmukhi' @gur2_dflt_rclt_wide_consonants by addak-gurmukhi.short bindi-gurmukhi;
        sub au-gurmukhi adakbindi-gurmukhi' @gur2_dflt_rclt_wide_consonants by addak-gurmukhi.short bindi-gurmukhi;
        sub [ee-gurmukhi ai-gurmukhi] addak-gurmukhi' @gur2_dflt_rclt_wide_consonants by addak-gurmukhi.short;
        sub au-gurmukhi addak-gurmukhi' @gur2_dflt_rclt_wide_consonants by addak-gurmukhi.short;
        sub [ee-gurmukhi ai-gurmukhi au-gurmukhi] adakbindi-gurmukhi' by addak-gurmukhi.short bindi-gurmukhi;
        sub [ee-gurmukhi ai-gurmukhi au-gurmukhi] addak-gurmukhi' by addak-gurmukhi.short;
        sub [ee-gurmukhi ai-gurmukhi] addak-gurmukhi.short bindi-gurmukhi headline-gurmukhi.short @gur2_dflt_rclt_wide_consonants @gur2_dflt_rclt_all_top_matras' by @gur2_dflt_rclt_all_top_matras_short;
        sub [ee-gurmukhi ai-gurmukhi] addak-gurmukhi.short bindi-gurmukhi headline-gurmukhi headline-gurmukhi.shorter @gur2_dflt_rclt_short_consonants @gur2_dflt_rclt_all_top_matras' by @gur2_dflt_rclt_all_top_matras_short;
        sub [au-gurmukhi] addak-gurmukhi.short bindi-gurmukhi headline-gurmukhi @gur2_dflt_rclt_wide_consonants @gur2_dflt_rclt_all_top_matras' by @gur2_dflt_rclt_all_top_matras_short;
        sub [au-gurmukhi] addak-gurmukhi.short bindi-gurmukhi headline-gurmukhi headline-gurmukhi @gur2_dflt_rclt_short_consonants @gur2_dflt_rclt_all_top_matras' by @gur2_dflt_rclt_all_top_matras_short;
        sub [ee-gurmukhi ai-gurmukhi] addak-gurmukhi.short headline-gurmukhi.short @gur2_dflt_rclt_wide_consonants @gur2_dflt_rclt_all_top_matras' by @gur2_dflt_rclt_all_top_matras_short;
        sub [ee-gurmukhi ai-gurmukhi] addak-gurmukhi.short headline-gurmukhi headline-gurmukhi.shorter @gur2_dflt_rclt_short_consonants @gur2_dflt_rclt_all_top_matras' by @gur2_dflt_rclt_all_top_matras_short;
        sub au-gurmukhi addak-gurmukhi.short headline-gurmukhi @gur2_dflt_rclt_wide_consonants @gur2_dflt_rclt_all_top_matras' by @gur2_dflt_rclt_all_top_matras_short;
        sub au-gurmukhi addak-gurmukhi.short headline-gurmukhi headline-gurmukhi @gur2_dflt_rclt_short_consonants @gur2_dflt_rclt_all_top_matras' by @gur2_dflt_rclt_all_top_matras_short;
    } auVowel_addak_adakbindi;

    # ---------------
    # Contexts: Bindi
    # ---------------
    lookup bindi_basics {
        lookupflag UseMarkFilteringSet @gur2_dflt_rclt_MFS_top_bindi_tippi;
        ignore sub @gur2_dflt_rclt_short_consonants @gur2_dflt_rclt_all_top_matras bindi-gurmukhi' @gur2_dflt_rclt_short_consonants @gur2_dflt_rclt_all_top_matras;
        #	ignore sub @gur2_dflt_rclt_short_consonants @gur2_dflt_rclt_top_matras_right_facing bindi-gurmukhi' @gur2_dflt_rclt_wide_consonants @gur2_dflt_rclt_all_top_matras; 
        sub [ii-gurmukhi iiMatra-gurmukhi] bindi-gurmukhi' @gur2_dflt_rclt_short_consonants @gur2_dflt_rclt_all_top_matras by bindi-gurmukhi headline-gurmukhi.short;
        sub @gur2_dflt_rclt_top_matras_left_facing bindi-gurmukhi' @gur2_dflt_rclt_short_consonants @gur2_dflt_rclt_all_top_matras by bindi-gurmukhi headline-gurmukhi.shorter;
        sub [ee-gurmukhi ai-gurmukhi] bindi-gurmukhi' @gur2_dflt_rclt_short_consonants @gur2_dflt_rclt_all_top_matras by bindi-gurmukhi headline-gurmukhi.shorter;
        sub [u-gurmukhi] bindi-gurmukhi' @gur2_dflt_rclt_short_consonants @gur2_dflt_rclt_all_top_matras by bindi-gurmukhi headline-gurmukhi.shorter;
        sub [au-gurmukhi auMatra-gurmukhi] bindi-gurmukhi' @gur2_dflt_rclt_short_consonants @gur2_dflt_rclt_all_top_matras by bindi-gurmukhi headline-gurmukhi;
        sub [au-gurmukhi auMatra-gurmukhi] bindi-gurmukhi' @gur2_dflt_rclt_short_consonants tippi-gurmukhi by bindi-gurmukhi headline-gurmukhi;
        sub [ii-gurmukhi iiMatra-gurmukhi] bindi-gurmukhi' [i-gurmukhi iMatra-gurmukhi] by bindi-gurmukhi headline-gurmukhi.short;
        sub @gur2_dflt_rclt_wide_consonants auMatra-gurmukhi bindi-gurmukhi' @gur2_dflt_rclt_punctuation_after by bindi-gurmukhi headline-gurmukhi;
        sub @gur2_dflt_rclt_wide_consonants auMatra-gurmukhi bindi-gurmukhi' [i-gurmukhi iMatra-gurmukhi] by bindi-gurmukhi headline-gurmukhi;
        sub [u-gurmukhi] bindi-gurmukhi' @gur2_dflt_rclt_punctuation_after by bindi-gurmukhi headline-gurmukhi.shorter;
        sub [u-gurmukhi] bindi-gurmukhi' [u-gurmukhi uu-gurmukhi] by bindi-gurmukhi headline-gurmukhi.shorter;
        sub [au-gurmukhi] bindi-gurmukhi' @gur2_dflt_rclt_punctuation_after by bindi-gurmukhi headline-gurmukhi.short;
        sub [au-gurmukhi] bindi-gurmukhi' [i-gurmukhi iMatra-gurmukhi] by bindi-gurmukhi headline-gurmukhi;
        sub [oo-gurmukhi ee-gurmukhi] bindi-gurmukhi' [i-gurmukhi iMatra-gurmukhi] by bindi-gurmukhi headline-gurmukhi.shorter;
        sub [uu-gurmukhi ai-gurmukhi] bindi-gurmukhi' [i-gurmukhi iMatra-gurmukhi] by bindi-gurmukhi headline-gurmukhi.short;
        sub [ii-gurmukhi iiMatra-gurmukhi] bindi-gurmukhi headline-gurmukhi.short @gur2_dflt_rclt_short_consonants @gur2_dflt_rclt_all_top_matras' by @gur2_dflt_rclt_all_top_matras_short;
        sub @gur2_dflt_rclt_top_matras_left_facing bindi-gurmukhi headline-gurmukhi.shorter @gur2_dflt_rclt_short_consonants @gur2_dflt_rclt_all_top_matras' by @gur2_dflt_rclt_all_top_matras_short;
        sub [ee-gurmukhi ai-gurmukhi] bindi-gurmukhi headline-gurmukhi.shorter @gur2_dflt_rclt_short_consonants @gur2_dflt_rclt_all_top_matras' by @gur2_dflt_rclt_all_top_matras_short;
        sub [u-gurmukhi] bindi-gurmukhi headline-gurmukhi.shorter @gur2_dflt_rclt_short_consonants @gur2_dflt_rclt_all_top_matras' by @gur2_dflt_rclt_all_top_matras_short;
        sub [au-gurmukhi auMatra-gurmukhi] bindi-gurmukhi headline-gurmukhi @gur2_dflt_rclt_short_consonants @gur2_dflt_rclt_all_top_matras' by @gur2_dflt_rclt_all_top_matras_short;
        sub [oo-gurmukhi] bindi-gurmukhi @gur2_dflt_rclt_short_consonants @gur2_dflt_rclt_all_top_matras' by @gur2_dflt_rclt_all_top_matras_short;
    } bindi_basics;

    lookup aumatra_bindi_short_consonants {
        lookupflag UseMarkFilteringSet @gur2_dflt_rclt_MFS_top_bindi_tippi;
        sub @gur2_dflt_rclt_short_consonants auMatra-gurmukhi bindi-gurmukhi @gur2_dflt_rclt_short_consonants @gur2_dflt_rclt_all_top_matras' by @gur2_dflt_rclt_all_top_matras_short;
    } aumatra_bindi_short_consonants;

    # ---------------
    # Contexts: Tippi
    # ---------------
    # Contexts with vowels (inherent) 'a', 'i', 'u', and 'uu' in final position.
    lookup imatra_tippi {
        lookupflag UseMarkFilteringSet @gur2_dflt_rclt_MFS_top_tippis;
        sub iMatra-gurmukhi @gur2_dflt_rclt_wide_consonants tippi-gurmukhi @gur2_dflt_rclt_short_consonants @gur2_dflt_rclt_all_top_matras' by @gur2_dflt_rclt_all_top_matras_short;
        sub @gur2_dflt_rclt_wide_consonants tippi-gurmukhi @gur2_dflt_rclt_short_consonants @gur2_dflt_rclt_all_top_matras' by @gur2_dflt_rclt_all_top_matras_short;
        sub i-gurmukhi tippi-gurmukhi' @gur2_dflt_rclt_short_consonants @gur2_dflt_rclt_all_top_matras by tippi-gurmukhi headline-gurmukhi.shorter;
        sub iMatra-gurmukhi @gur2_dflt_rclt_short_consonants tippi-gurmukhi' by tippi-gurmukhi.short;
        sub u-gurmukhi tippi-gurmukhi' @gur2_dflt_rclt_wide_consonants @gur2_dflt_rclt_all_top_matras by tippi-gurmukhi.short headline-gurmukhi.shorter;
        sub u-gurmukhi tippi-gurmukhi' @gur2_dflt_rclt_short_consonants @gur2_dflt_rclt_all_top_matras by tippi-gurmukhi.short headline-gurmukhi headline-gurmukhi.short;
        sub u-gurmukhi tippi-gurmukhi' @gur2_dflt_rclt_short_consonants tippi-gurmukhi by tippi-gurmukhi.short headline-gurmukhi.short;
        sub u-gurmukhi tippi-gurmukhi' [@gur2_dflt_rclt_wide_consonants @gur2_dflt_rclt_short_consonants] by tippi-gurmukhi.short;
        sub u-gurmukhi tippi-gurmukhi' [i-gurmukhi iMatra-gurmukhi] by tippi-gurmukhi.short headline-gurmukhi;
        sub [u-gurmukhi uu-gurmukhi] tippi-gurmukhi' @gur2_dflt_rclt_punctuation_after by tippi-gurmukhi.short headline-gurmukhi;
        sub u-gurmukhi tippi-gurmukhi' [u-gurmukhi uu-gurmukhi] by tippi-gurmukhi.short headline-gurmukhi;
        sub i-gurmukhi tippi-gurmukhi headline-gurmukhi.shorter @gur2_dflt_rclt_short_consonants @gur2_dflt_rclt_all_top_matras' by @gur2_dflt_rclt_all_top_matras_short;
        sub u-gurmukhi tippi-gurmukhi.short headline-gurmukhi.shorter @gur2_dflt_rclt_wide_consonants @gur2_dflt_rclt_all_top_matras' by @gur2_dflt_rclt_all_top_matras_short;
        sub u-gurmukhi tippi-gurmukhi.short headline-gurmukhi headline-gurmukhi.short @gur2_dflt_rclt_short_consonants @gur2_dflt_rclt_all_top_matras' by @gur2_dflt_rclt_all_top_matras_short;
        sub u-gurmukhi tippi-gurmukhi.short headline-gurmukhi.short @gur2_dflt_rclt_short_consonants tippi-gurmukhi' by tippi-gurmukhi.short;
    } imatra_tippi;

    # --------------------
    # Contexts: Top Matras
    # --------------------
    lookup gur2_dflt_rclt_simple_mark_adjustments {
        lookupflag UseMarkFilteringSet @gur2_dflt_rclt_all_top_matras;
        sub @gur2_dflt_rclt_wide_consonants auMatra-gurmukhi @gur2_dflt_rclt_short_consonants @gur2_dflt_rclt_all_top_matras' by @gur2_dflt_rclt_all_top_matras_short;
        sub @gur2_dflt_rclt_wide_consonants auMatra-gurmukhi' [i-gurmukhi iMatra-gurmukhi] by auMatra-gurmukhi headline-gurmukhi.shorter;
        sub au-gurmukhi @gur2_dflt_rclt_short_consonants @gur2_dflt_rclt_all_top_matras' by @gur2_dflt_rclt_all_top_matras_short;
        sub au-gurmukhi' [i-gurmukhi iMatra-gurmukhi] by au-gurmukhi headline-gurmukhi.shorter;
    } gur2_dflt_rclt_simple_mark_adjustments;

} rclt;

feature hist {
    script gur2;
    lookup gur2_dflt_hist_historical_sunscript_consonants {
        ignore sub [rakar-gurmukhi va-gurmukhi.below ha-gurmukhi.below yakash-gurmukhi ca-gurmukhi.below tta-gurmukhi.below ta-gurmukhi.below] halant-gurmukhi' [ca-gurmukhi tta-gurmukhi ta-gurmukhi]';
        sub halant-gurmukhi' lookup gur2_dflt_ss01_historical_below_base_consonant_forms [ca-gurmukhi tta-gurmukhi ta-gurmukhi]';
    } gur2_dflt_hist_historical_sunscript_consonants;

} hist;

feature tnum {
    script gur2;
    lookup gur2_dflt_tnum_tabular_numerals {
        sub @gur2_dflt_tnum_standard_figures by @gur2_dflt_tnum_tabular_figures;
    } gur2_dflt_tnum_tabular_numerals;

} tnum;
