@gur2_dflt_rclt_all_top_matras = [eeMatra-gurmukhi aiMatra-gurmukhi ooMatra-gurmukhi auMatra-gurmukhi];
@gur2_dflt_rclt_all_top_matras_short = [eeMatra-gurmukhi.short aiMatra-gurmukhi.short ooMatra-gurmukhi.short auMatra-gurmukhi.short];
@gur2_dflt_rclt_top_matras_left_facing = [eeMatra-gurmukhi aiMatra-gurmukhi ooMatra-gurmukhi];
@gur2_dflt_rclt_wide_consonants = [ka-gurmukhi kha-gurmukhi ga-gurmukhi gha-gurmukhi nga-gurmukhi ca-gurmukhi cha-gurmukhi ja-gurmukhi jha-gurmukhi nya-gurmukhi tta-gurmukhi dda-gurmukhi ddha-gurmukhi nna-gurmukhi ta-gurmukhi tha-gurmukhi da-gurmukhi dha-gurmukhi pa-gurmukhi pha-gurmukhi ba-gurmukhi bha-gurmukhi ma-gurmukhi ya-gurmukhi ra-gurmukhi la-gurmukhi lla-gurmukhi va-gurmukhi sha-gurmukhi sa-gurmukhi ha-gurmukhi khha-gurmukhi ghha-gurmukhi za-gurmukhi rra-gurmukhi fa-gurmukhi ya-gurmukhi.psts aaMatra-gurmukhi];
@gur2_dflt_rclt_short_consonants = [ttha-gurmukhi na-gurmukhi];
@gur2_dflt_rclt_all_below_marks = [nukta-gurmukhi uMatra-gurmukhi uuMatra-gurmukhi halant-gurmukhi udaat-gurmukhi yakash-gurmukhi rakar-gurmukhi va-gurmukhi.below ha-gurmukhi.below ca-gurmukhi.below tta-gurmukhi.below ta-gurmukhi.below];
@gur2_dflt_rclt_bottom_consonants = [rakar-gurmukhi va-gurmukhi.below ha-gurmukhi.below ca-gurmukhi.below tta-gurmukhi.below ta-gurmukhi.below];
@gur2_dflt_rclt_punctuation_after = [space danda-deva.loclGURM dbldanda-deva.loclGURM comma.loclGURM colon.loclGURM semicolon.loclGURM exclam.loclGURM question.loclGURM ellipsis.loclGURM parenright.loclGURM bracketright.loclGURM braceright.loclGURM quoteright.loclGURM quotedblright.loclGURM];
@gur2_dflt_rclt_MFS_top_addak_adakbindi = [addak-gurmukhi adakbindi-gurmukhi eeMatra-gurmukhi aiMatra-gurmukhi ooMatra-gurmukhi auMatra-gurmukhi];
@gur2_dflt_rclt_MFS_addak_adakbindi = [addak-gurmukhi adakbindi-gurmukhi];
@gur2_dflt_rclt_MFS_top_bindi_addaks = [adakbindi-gurmukhi addak-gurmukhi addak-gurmukhi.short bindi-gurmukhi eeMatra-gurmukhi aiMatra-gurmukhi ooMatra-gurmukhi auMatra-gurmukhi];
@gur2_dflt_rclt_MFS_top_bindi_tippi = [eeMatra-gurmukhi aiMatra-gurmukhi ooMatra-gurmukhi auMatra-gurmukhi bindi-gurmukhi tippi-gurmukhi];
@gur2_dflt_rclt_MFS_top_tippis = [tippi-gurmukhi tippi-gurmukhi.short eeMatra-gurmukhi aiMatra-gurmukhi ooMatra-gurmukhi auMatra-gurmukhi];
@gur2_dflt_tnum_standard_figures = [zero-gurmukhi one-gurmukhi two-gurmukhi three-gurmukhi four-gurmukhi five-gurmukhi six-gurmukhi seven-gurmukhi eight-gurmukhi nine-gurmukhi];
@gur2_dflt_tnum_tabular_figures = [zero-gurmukhi.tf one-gurmukhi.tf two-gurmukhi.tf three-gurmukhi.tf four-gurmukhi.tf five-gurmukhi.tf six-gurmukhi.tf seven-gurmukhi.tf eight-gurmukhi.tf nine-gurmukhi.tf];
# Prefix: LanguageSystems
languagesystem DFLT dflt;
languagesystem gur2 dflt;
# Prefix: IndependentLookups
lookup gur2_dflt_blwf_below_base_consonant_forms {
    sub halant-gurmukhi ra-gurmukhi by rakar-gurmukhi;
    sub halant-gurmukhi ha-gurmukhi by ha-gurmukhi.below;
    sub halant-gurmukhi va-gurmukhi by va-gurmukhi.below;
} gur2_dflt_blwf_below_base_consonant_forms;

lookup gur2_dflt_ss01_historical_below_base_consonant_forms {
    sub halant-gurmukhi ca-gurmukhi by ca-gurmukhi.below;
    sub halant-gurmukhi tta-gurmukhi by tta-gurmukhi.below;
    sub halant-gurmukhi ta-gurmukhi by ta-gurmukhi.below;
} gur2_dflt_ss01_historical_below_base_consonant_forms;

feature locl {
    script gur2;
    lookup gurmukhi_punctuation {
        sub [period comma colon semicolon ellipsis exclam question asterisk parenleft parenright braceleft braceright bracketleft bracketright quotedblleft quotedblright quoteleft quoteright] by [period.loclGURM comma.loclGURM colon.loclGURM semicolon.loclGURM ellipsis.loclGURM exclam.loclGURM question.loclGURM asterisk.loclGURM parenleft.loclGURM parenright.loclGURM braceleft.loclGURM braceright.loclGURM bracketleft.loclGURM bracketright.loclGURM quotedblleft.loclGURM quotedblright.loclGURM quoteleft.loclGURM quoteright.loclGURM];
        sub danda-deva by danda-deva.loclGURM;
        sub dbldanda-deva by dbldanda-deva.loclGURM;
    } gurmukhi_punctuation;
} locl;

feature nukt {
    script gur2;
    lookup gur2_dflt_nukt_nukta_forms {
        sub la-gurmukhi nukta-gurmukhi by lla-gurmukhi;
        sub kha-gurmukhi nukta-gurmukhi by khha-gurmukhi;
        sub gha-gurmukhi nukta-gurmukhi by ghha-gurmukhi;
        sub ja-gurmukhi nukta-gurmukhi by za-gurmukhi;
        sub pha-gurmukhi nukta-gurmukhi by fa-gurmukhi;
    } gur2_dflt_nukt_nukta_forms;

} nukt;

feature blwf {
    script gur2;
    lookup gur2_dflt_blwf_below_base_forms {
        ignore sub [rakar-gurmukhi va-gurmukhi.below ha-gurmukhi.below yakash-gurmukhi] halant-gurmukhi' [ra-gurmukhi va-gurmukhi ha-gurmukhi]';
        sub halant-gurmukhi' lookup gur2_dflt_blwf_below_base_consonant_forms [ra-gurmukhi va-gurmukhi ha-gurmukhi]';
    } gur2_dflt_blwf_below_base_forms;

} blwf;

feature pstf {
    script gur2;
    lookup gur2_dflt_psts_post_base_forms {
        sub halant-gurmukhi ya-gurmukhi by ya-gurmukhi.psts;
    } gur2_dflt_psts_post_base_forms;

} pstf;

feature abvs {
    script gur2;
    lookup test_abvs {
        sub @gur2_dflt_rclt_all_top_matras adakbindi-gurmukhi' by addak-gurmukhi.short bindi-gurmukhi;
        sub @gur2_dflt_rclt_all_top_matras addak-gurmukhi' by addak-gurmukhi.short;
    } test_abvs;

    lookup test_abvs_2 {
        sub [u-gurmukhi uu-gurmukhi ii-gurmukhi iiMatra-gurmukhi] adakbindi-gurmukhi' by addak-gurmukhi.short bindi-gurmukhi;
        sub [u-gurmukhi uu-gurmukhi ii-gurmukhi iiMatra-gurmukhi] addak-gurmukhi' by addak-gurmukhi.short;
    } test_abvs_2;

} abvs;

feature rclt {
    script gur2;
    # ---------------
    # Contexts: Addak
    # ---------------
    lookup gur2_dflt_rclt_addak_bindi_default {
        # Addak-Bindi
        ignore sub @gur2_dflt_rclt_wide_consonants auMatra-gurmukhi addak-gurmukhi.short bindi-gurmukhi' [@gur2_dflt_rclt_wide_consonants @gur2_dflt_rclt_short_consonants] @gur2_dflt_rclt_all_below_marks @gur2_dflt_rclt_all_top_matras;
        ignore sub @gur2_dflt_rclt_short_consonants [@gur2_dflt_rclt_top_matras_left_facing auMatra-gurmukhi] addak-gurmukhi.short bindi-gurmukhi' [@gur2_dflt_rclt_wide_consonants ttha-gurmukhi] @gur2_dflt_rclt_all_below_marks @gur2_dflt_rclt_all_top_matras;
        ignore sub @gur2_dflt_rclt_wide_consonants auMatra-gurmukhi addak-gurmukhi.short bindi-gurmukhi' [@gur2_dflt_rclt_wide_consonants @gur2_dflt_rclt_short_consonants] @gur2_dflt_rclt_all_top_matras;
        ignore sub @gur2_dflt_rclt_short_consonants [@gur2_dflt_rclt_top_matras_left_facing auMatra-gurmukhi] addak-gurmukhi.short bindi-gurmukhi' [@gur2_dflt_rclt_wide_consonants ttha-gurmukhi] @gur2_dflt_rclt_all_top_matras;
        sub addak-gurmukhi.short bindi-gurmukhi' @gur2_dflt_rclt_wide_consonants @gur2_dflt_rclt_all_below_marks @gur2_dflt_rclt_all_top_matras by bindi-gurmukhi headline-gurmukhi.shorter;
        sub addak-gurmukhi.short bindi-gurmukhi' @gur2_dflt_rclt_short_consonants @gur2_dflt_rclt_all_below_marks @gur2_dflt_rclt_all_top_matras by bindi-gurmukhi headline-gurmukhi headline-gurmukhi.shorter;
        sub addak-gurmukhi.short bindi-gurmukhi' @gur2_dflt_rclt_wide_consonants @gur2_dflt_rclt_all_top_matras by bindi-gurmukhi headline-gurmukhi.shorter;
        sub addak-gurmukhi.short bindi-gurmukhi' @gur2_dflt_rclt_short_consonants @gur2_dflt_rclt_all_top_matras by bindi-gurmukhi headline-gurmukhi headline-gurmukhi.shorter;
        sub addak-gurmukhi.short bindi-gurmukhi headline-gurmukhi.shorter @gur2_dflt_rclt_wide_consonants @gur2_dflt_rclt_all_below_marks @gur2_dflt_rclt_all_top_matras' by @gur2_dflt_rclt_all_top_matras_short;
        sub addak-gurmukhi.short bindi-gurmukhi headline-gurmukhi headline-gurmukhi.shorter @gur2_dflt_rclt_short_consonants @gur2_dflt_rclt_all_below_marks @gur2_dflt_rclt_all_top_matras' by @gur2_dflt_rclt_all_top_matras_short;
        sub addak-gurmukhi.short bindi-gurmukhi headline-gurmukhi.shorter @gur2_dflt_rclt_wide_consonants @gur2_dflt_rclt_all_top_matras' by @gur2_dflt_rclt_all_top_matras_short;
        sub addak-gurmukhi.short bindi-gurmukhi headline-gurmukhi headline-gurmukhi.shorter @gur2_dflt_rclt_short_consonants @gur2_dflt_rclt_all_top_matras' by @gur2_dflt_rclt_all_top_matras_short;
    } gur2_dflt_rclt_addak_bindi_default;

    lookup gur2_dflt_rclt_addak_default {
        # Addak
        ignore sub @gur2_dflt_rclt_wide_consonants auMatra-gurmukhi addak-gurmukhi.short' [@gur2_dflt_rclt_wide_consonants @gur2_dflt_rclt_short_consonants] @gur2_dflt_rclt_all_below_marks @gur2_dflt_rclt_all_top_matras;
        ignore sub @gur2_dflt_rclt_short_consonants [@gur2_dflt_rclt_top_matras_left_facing auMatra-gurmukhi] addak-gurmukhi.short' [@gur2_dflt_rclt_wide_consonants @gur2_dflt_rclt_short_consonants] @gur2_dflt_rclt_all_below_marks @gur2_dflt_rclt_all_top_matras;
        ignore sub @gur2_dflt_rclt_wide_consonants auMatra-gurmukhi addak-gurmukhi.short' [@gur2_dflt_rclt_wide_consonants @gur2_dflt_rclt_short_consonants] @gur2_dflt_rclt_all_top_matras;
        ignore sub @gur2_dflt_rclt_short_consonants [@gur2_dflt_rclt_top_matras_left_facing auMatra-gurmukhi] addak-gurmukhi.short' [@gur2_dflt_rclt_wide_consonants @gur2_dflt_rclt_short_consonants] @gur2_dflt_rclt_all_top_matras;
        sub addak-gurmukhi.short' @gur2_dflt_rclt_wide_consonants @gur2_dflt_rclt_all_below_marks @gur2_dflt_rclt_all_top_matras by addak-gurmukhi.short headline-gurmukhi.shorter;
        sub addak-gurmukhi.short' @gur2_dflt_rclt_short_consonants @gur2_dflt_rclt_all_below_marks @gur2_dflt_rclt_all_top_matras by addak-gurmukhi.short headline-gurmukhi headline-gurmukhi.shorter;
        sub addak-gurmukhi.short' @gur2_dflt_rclt_wide_consonants @gur2_dflt_rclt_all_top_matras by addak-gurmukhi.short headline-gurmukhi.shorter;
        sub addak-gurmukhi.short' @gur2_dflt_rclt_short_consonants @gur2_dflt_rclt_all_top_matras by addak-gurmukhi.short headline-gurmukhi headline-gurmukhi.shorter;
        sub addak-gurmukhi.short headline-gurmukhi.shorter @gur2_dflt_rclt_wide_consonants @gur2_dflt_rclt_all_below_marks @gur2_dflt_rclt_all_top_matras' by @gur2_dflt_rclt_all_top_matras_short;
        sub addak-gurmukhi.short headline-gurmukhi headline-gurmukhi.shorter @gur2_dflt_rclt_short_consonants @gur2_dflt_rclt_all_below_marks @gur2_dflt_rclt_all_top_matras' by @gur2_dflt_rclt_all_top_matras_short;
        sub addak-gurmukhi.short headline-gurmukhi.shorter @gur2_dflt_rclt_wide_consonants @gur2_dflt_rclt_all_top_matras' by @gur2_dflt_rclt_all_top_matras_short;
        sub addak-gurmukhi.short headline-gurmukhi headline-gurmukhi.shorter @gur2_dflt_rclt_short_consonants @gur2_dflt_rclt_all_top_matras' by @gur2_dflt_rclt_all_top_matras_short;
    } gur2_dflt_rclt_addak_default;

    lookup gur2_dflt_rclt_addak_bindi_exceptions {
        # Addak-Bindi
        sub @gur2_dflt_rclt_short_consonants @gur2_dflt_rclt_top_matras_left_facing addak-gurmukhi.short bindi-gurmukhi' @gur2_dflt_rclt_short_consonants @gur2_dflt_rclt_all_below_marks @gur2_dflt_rclt_all_top_matras by bindi-gurmukhi headline-gurmukhi.shorter;
        sub @gur2_dflt_rclt_short_consonants auMatra-gurmukhi addak-gurmukhi.short bindi-gurmukhi' @gur2_dflt_rclt_short_consonants @gur2_dflt_rclt_all_below_marks @gur2_dflt_rclt_all_top_matras by bindi-gurmukhi headline-gurmukhi;
        sub @gur2_dflt_rclt_short_consonants @gur2_dflt_rclt_top_matras_left_facing addak-gurmukhi.short bindi-gurmukhi' @gur2_dflt_rclt_short_consonants @gur2_dflt_rclt_all_top_matras by bindi-gurmukhi headline-gurmukhi.shorter;
        sub @gur2_dflt_rclt_short_consonants auMatra-gurmukhi addak-gurmukhi.short bindi-gurmukhi' @gur2_dflt_rclt_short_consonants @gur2_dflt_rclt_all_top_matras by bindi-gurmukhi headline-gurmukhi;
        sub @gur2_dflt_rclt_short_consonants @gur2_dflt_rclt_top_matras_left_facing addak-gurmukhi.short bindi-gurmukhi headline-gurmukhi.shorter @gur2_dflt_rclt_short_consonants @gur2_dflt_rclt_all_below_marks @gur2_dflt_rclt_all_top_matras' by @gur2_dflt_rclt_all_top_matras_short;
        sub @gur2_dflt_rclt_short_consonants auMatra-gurmukhi addak-gurmukhi.short bindi-gurmukhi headline-gurmukhi @gur2_dflt_rclt_short_consonants @gur2_dflt_rclt_all_below_marks @gur2_dflt_rclt_all_top_matras' by @gur2_dflt_rclt_all_top_matras_short;
        sub @gur2_dflt_rclt_short_consonants auMatra-gurmukhi addak-gurmukhi.short bindi-gurmukhi @gur2_dflt_rclt_wide_consonants @gur2_dflt_rclt_all_below_marks @gur2_dflt_rclt_all_top_matras' by @gur2_dflt_rclt_all_top_matras_short;
        sub @gur2_dflt_rclt_short_consonants @gur2_dflt_rclt_top_matras_left_facing addak-gurmukhi.short bindi-gurmukhi headline-gurmukhi.shorter @gur2_dflt_rclt_short_consonants @gur2_dflt_rclt_all_top_matras' by @gur2_dflt_rclt_all_top_matras_short;
        sub @gur2_dflt_rclt_short_consonants auMatra-gurmukhi addak-gurmukhi.short bindi-gurmukhi headline-gurmukhi @gur2_dflt_rclt_short_consonants @gur2_dflt_rclt_all_top_matras' by @gur2_dflt_rclt_all_top_matras_short;
        sub @gur2_dflt_rclt_short_consonants auMatra-gurmukhi addak-gurmukhi.short bindi-gurmukhi @gur2_dflt_rclt_wide_consonants @gur2_dflt_rclt_all_top_matras' by @gur2_dflt_rclt_all_top_matras_short;
        sub @gur2_dflt_rclt_wide_consonants auMatra-gurmukhi addak-gurmukhi.short bindi-gurmukhi' @gur2_dflt_rclt_short_consonants @gur2_dflt_rclt_all_below_marks @gur2_dflt_rclt_all_top_matras by bindi-gurmukhi headline-gurmukhi headline-gurmukhi headline-gurmukhi.shorter;
        sub @gur2_dflt_rclt_wide_consonants auMatra-gurmukhi addak-gurmukhi.short bindi-gurmukhi' @gur2_dflt_rclt_wide_consonants @gur2_dflt_rclt_all_below_marks @gur2_dflt_rclt_all_top_matras by bindi-gurmukhi headline-gurmukhi headline-gurmukhi.shorter;
        sub @gur2_dflt_rclt_wide_consonants auMatra-gurmukhi addak-gurmukhi.short bindi-gurmukhi' @gur2_dflt_rclt_short_consonants @gur2_dflt_rclt_all_top_matras by bindi-gurmukhi headline-gurmukhi headline-gurmukhi headline-gurmukhi.shorter;
        sub @gur2_dflt_rclt_wide_consonants auMatra-gurmukhi addak-gurmukhi.short bindi-gurmukhi' @gur2_dflt_rclt_wide_consonants @gur2_dflt_rclt_all_top_matras by bindi-gurmukhi headline-gurmukhi headline-gurmukhi.shorter;
        sub @gur2_dflt_rclt_wide_consonants auMatra-gurmukhi addak-gurmukhi.short bindi-gurmukhi headline-gurmukhi headline-gurmukhi headline-gurmukhi.shorter @gur2_dflt_rclt_short_consonants @gur2_dflt_rclt_all_below_marks @gur2_dflt_rclt_all_top_matras' by @gur2_dflt_rclt_all_top_matras_short;
        sub @gur2_dflt_rclt_wide_consonants auMatra-gurmukhi addak-gurmukhi.short bindi-gurmukhi headline-gurmukhi headline-gurmukhi.shorter @gur2_dflt_rclt_wide_consonants @gur2_dflt_rclt_all_below_marks @gur2_dflt_rclt_all_top_matras' by @gur2_dflt_rclt_all_top_matras_short;
        sub @gur2_dflt_rclt_wide_consonants auMatra-gurmukhi addak-gurmukhi.short bindi-gurmukhi headline-gurmukhi headline-gurmukhi headline-gurmukhi.shorter @gur2_dflt_rclt_short_consonants @gur2_dflt_rclt_all_top_matras' by @gur2_dflt_rclt_all_top_matras_short;
        sub @gur2_dflt_rclt_wide_consonants auMatra-gurmukhi addak-gurmukhi.short bindi-gurmukhi headline-gurmukhi headline-gurmukhi.shorter @gur2_dflt_rclt_wide_consonants @gur2_dflt_rclt_all_top_matras' by @gur2_dflt_rclt_all_top_matras_short;
    } gur2_dflt_rclt_addak_bindi_exceptions;

    lookup gur2_dflt_rclt_addak_exceptions {
        # Addak
