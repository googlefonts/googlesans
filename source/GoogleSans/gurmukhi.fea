        sub @gur2_dflt_rclt_wide_consonants addak-gurmukhi headline-gurmukhi.shorter @gur2_dflt_rclt_short_consonants @gur2_dflt_rclt_all_top_matras' by @gur2_dflt_rclt_all_top_matras_short;
        sub @gur2_dflt_rclt_wide_consonants adakbindi-gurmukhi headline-gurmukhi.shorter @gur2_dflt_rclt_short_consonants @gur2_dflt_rclt_all_top_matras' by @gur2_dflt_rclt_all_top_matras_short;
