        sub rra-malayalam llVocalicMatra-malayalam by rra_llVocalicMatra-malayalam;
        sub llla-malayalam llVocalicMatra-malayalam by llla_llVocalicMatra-malayalam;
    } MALM_dflt_blws_lVocalicMatraLigatures;

} blws;

feature psts {
    script mlm2;
    lookup MALM_dflt_psts_consonant_postBaseForm_ligatures {
        sub ya-malayalam ya-malayalam.post by y_ya-malayalam;
        sub va-malayalam va-malayalam.post by v_va-malayalam;
    } MALM_dflt_psts_consonant_postBaseForm_ligatures;

} psts;

