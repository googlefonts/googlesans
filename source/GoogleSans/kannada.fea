# Prefix: IndependentLookups
lookup KND_dflt_none_halant_forms {
	sub [@KND_all_consonants k_ssa-kannada] by [@KND_all_half_forms k_ss-kannada];
} KND_dflt_none_halant_forms;

lookup KND_dflt_none_halant_null {
	sub halant-kannada by zerowidthspace;
} KND_dflt_none_halant_null;

lookup KND_dflt_none_ssa_short {
	sub @KND_ssa by @KND_short_ssa;
} KND_dflt_none_ssa_short;


