feature akhn {
script knd2;

lookup KND_dflt_akhn_akhands {
lookupflag UseMarkFilteringSet @KND_UMFS_haln_marks;
	ignore sub @KND_all_consonants_except_ra halant-kannada ka-kannada' halant-kannada' ssa-kannada';
	sub ka-kannada' halant-kannada' ssa-kannada' by k_ssa-kannada;
} KND_dflt_akhn_akhands;

} akhn;

