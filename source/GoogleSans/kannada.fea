} KND_dflt_psts_short_ssa;

lookup KND_dflt_psts_vattu_vertical_shift {
	pos @KND_short_ssa @KND_allVattus' <0 -40 0 0>;
} KND_dflt_psts_vattu_vertical_shift;

} psts;

feature haln {
script knd2;

lookup KND_dflt_psts_halant_ligatures {
lookupflag UseMarkFilteringSet @KND_UMFS_haln_marks;
	sub [@KND_all_consonants k_ssa-kannada]' lookup KND_dflt_none_halant_forms @KND_allVattus' @KND_allVattus' @KND_allVattus' halant-kannada' lookup KND_dflt_none_halant_null;
	sub [@KND_all_consonants k_ssa-kannada]' lookup KND_dflt_none_halant_forms @KND_allVattus' @KND_allVattus' halant-kannada' lookup KND_dflt_none_halant_null;
	sub [@KND_all_consonants k_ssa-kannada]' lookup KND_dflt_none_halant_forms @KND_allVattus' halant-kannada' lookup KND_dflt_none_halant_null;
	sub [@KND_all_consonants k_ssa-kannada]' lookup KND_dflt_none_halant_forms halant-kannada' lookup KND_dflt_none_halant_null;
} KND_dflt_psts_halant_ligatures;

} haln;

feature rclt {
script knd2;

lookup KND_dflt_rclt_stacking_ra_vattu_under_akhands_single_adjustment {
	pos [k_ssa-kannada k_ssi-kannada k_sse-kannada]' ra-kannada.below.alt [@KND_k_ssa_ligatures space nbspace] <0 0 180 0>;
	pos [ja-kannada ji-kannada je-kannada]' nya-kannada.below.nonspacing ra-kannada.below.alt [space nbspace] <0 0 50 0>;
} KND_dflt_rclt_stacking_ra_vattu_under_akhands_single_adjustment;

lookup KND_dflt_haln_contextual_nuktas {
	sub @KND_pha_nukta nukta-kannada' by nukta-kannada.wide;
	sub ja-kannada.below nukta-kannada' by nukta-kannada.below;
	sub pha-kannada.below nukta-kannada' by nukta-kannada.below.wide;
} KND_dflt_haln_contextual_nuktas;

lookup KND_dflt_rclt_below_base_single_adjustments {
	pos k_sse-kannada' ra-kannada.below.alt ailength-kannada <0 0 500 0>;
	pos je-kannada' nya-kannada.below.nonspacing ra-kannada.below.alt ailength-kannada <0 0 390 0>;
	pos @KND_ja_glyphs' nukta-kannada [ja-kannada.below] <0 0 160 0>;
	pos @KND_pha_nukta' nukta-kannada.wide [pha-kannada.below] <0 0 160 0>;
} KND_dflt_rclt_below_base_single_adjustments;
} rclt;
