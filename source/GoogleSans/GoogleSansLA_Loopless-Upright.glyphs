	script lao;
	sub [koKai-lao khoKhai-lao khoKhuay-lao gha-lao ngoNgu-lao coCok-lao cha-lao soSang-lao jha-lao nyoNyung-lao nya-lao tta-lao ttha-lao dda-lao ddha-lao nna-lao doDek-lao toTa-lao thoThong-lao thoThung-lao dha-lao noNok-lao boBae-lao phoPhueng-lao phoPhu-lao bha-lao moMa-lao roRot-lao loLing-lao woWi-lao sha-lao ssa-lao soSeua-lao hoHaan-lao oO-lao hoHeuan-lao lla-lao khmuGo-lao khmuNyo-lao hoNo-lao hoMo-lao] [niggahita_maiEk-lao niggahita_maiTho-lao niggahita_maiTi-lao niggahita_maiCatawa-lao]' aaVowel-lao by [niggahita_maiEk-lao.right niggahita_maiTho-lao.right niggahita_maiTi-lao.right niggahita_maiCatawa-lao.right];
