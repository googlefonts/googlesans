feature abvs {
    script ory2;
    lookup ODI_dflt_abvs_above_base_matra_ligatures {
        sub iMatra-oriya reph-oriya by iMatra_reph-oriya;
    } ODI_dflt_abvs_above_base_matra_ligatures;

    lookup ODI_dflt_abvs_iMatraLength {
        sub @ODI_wideBases iMatra-oriya' by iMatra-oriya.alt1;
        sub @ODI_wideBases iMatra_reph-oriya' by iMatra_reph-oriya.alt1;
    } ODI_dflt_abvs_iMatraLength;

    lookup ODI_dflt_abvs_aiLength_alternate {
        sub @ODI_aiLength_alternate aiLength-oriya' by aiLength-oriya.alt;
    } ODI_dflt_abvs_aiLength_alternate;

} abvs;

feature blws {
