feature locl {
    script ory2;
    lookup ODI_dflt_locl_odiaPunctuation {
        sub [period comma colon semicolon ellipsis exclam question asterisk parenleft parenright braceleft braceright bracketleft bracketright quotedblleft quotedblright quoteleft quoteright] by [period.loclODIA comma.loclODIA colon.loclODIA semicolon.loclODIA ellipsis.loclODIA exclam.loclODIA question.loclODIA asterisk.loclODIA parenleft.loclODIA parenright.loclODIA braceleft.loclODIA braceright.loclODIA bracketleft.loclODIA bracketright.loclODIA quotedblleft.loclODIA quotedblright.loclODIA quoteleft.loclODIA quoteright.loclODIA];
    } ODI_dflt_locl_odiaPunctuation;

    lookup ODI_dflt_locl_odiaDanda {
        sub [danda-deva dbldanda-deva] by [danda-deva.loclODIA dbldanda-deva.loclODIA];
    } ODI_dflt_locl_odiaDanda;

} locl;

feature nukt {
    script ory2;
    lookup ODI_dflt_nukt_nukta_forms {
        sub dda-oriya nukta-oriya by rra-oriya;
        sub ddha-oriya nukta-oriya by rha-oriya;
    } ODI_dflt_nukt_nukta_forms;

} nukt;

feature akhn {
    script ory2;
    lookup ODI_dflt_akhn_akhand_conjuncts {
        lookupflag MarkAttachmentType @ODI_MAT_halant;
        sub ka-oriya halant-oriya ssa-oriya by k_ssa-oriya;
        sub ja-oriya halant-oriya nya-oriya by j_nya-oriya;
    } ODI_dflt_akhn_akhand_conjuncts;

} akhn;

feature rphf {
    script ory2;
    lookup ODI_dflt_rphf_reph_form {
        sub ra-oriya halant-oriya by reph-oriya;
    } ODI_dflt_rphf_reph_form;

} rphf;

