<?xml version='1.0' encoding='UTF-8'?>
<designspace format="4.0">
  <axes>
    <axis tag="opsz" name="Optical size" minimum="14" maximum="24" default="18"/>
    <axis tag="wght" name="Weight" minimum="400" maximum="700" default="400">
      <map input="400" output="380"/>
      <map input="500" output="555"/>
      <map input="700" output="734"/>
    </axis>
  </axes>
  <rules>
    <rule name="BRACKET.14.24">
      <conditionset>
        <condition name="Optical size" minimum="14" maximum="24"/>
      </conditionset>
      <sub name="nine.alt" with="nine.alt.BRACKET.14"/>
      <sub name="nine.cap" with="nine.cap.BRACKET.14"/>
      <sub name="one.alt" with="one.alt.BRACKET.14"/>
      <sub name="one.cap" with="one.cap.BRACKET.14"/>
      <sub name="seven.alt" with="seven.alt.BRACKET.14"/>
      <sub name="seven.cap" with="seven.cap.BRACKET.14"/>
      <sub name="six.alt" with="six.alt.BRACKET.14"/>
      <sub name="six.cap" with="six.cap.BRACKET.14"/>
      <sub name="zero.alt" with="zero.alt.BRACKET.14"/>
    </rule>
    <rule name="BRACKET.16.24">
      <conditionset>
        <condition name="Optical size" minimum="16" maximum="24"/>
      </conditionset>
      <sub name="G" with="G.BRACKET.16"/>
      <sub name="comma" with="comma.BRACKET.16"/>
      <sub name="commaaccentcomb" with="commaaccentcomb.BRACKET.16"/>
      <sub name="quotedblbase" with="quotedblbase.BRACKET.16"/>
      <sub name="quotedblleft" with="quotedblleft.BRACKET.16"/>
      <sub name="quotedblright" with="quotedblright.BRACKET.16"/>
      <sub name="quoteleft" with="quoteleft.BRACKET.16"/>
      <sub name="quoteright" with="quoteright.BRACKET.16"/>
      <sub name="quotesinglbase" with="quotesinglbase.BRACKET.16"/>
      <sub name="semicolon" with="semicolon.BRACKET.16"/>
      <sub name="y" with="y.BRACKET.16"/>
    </rule>
  </rules>
