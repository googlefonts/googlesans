name = macintoshFONDFamilyID;
value = 128;
},
{
name = note;
value = "# Adjustment notes\012\012- All legacy marks have been made out of components to reduce the repetition in hinting\012- All accent marks have been slightly modified in height and position to align better. This is true in ALL optical sizes\012\012- Numbers (0123456789) (+tf variants) jump at optical size 14 to avoid a form morphing in interim steps (Angled to straight forms), which can look strange.\012\012\012â€“ symbols â€“ fixed minor spacing errors (tabular forms in the period.tf comma.tf colon.tf)\012\012â€“ tcommaaccent.alt had an incorrect form \012â€“ tcedilla.alt was missing. Added in!\012â€“ jdotless.alt jcircumflex.alt added\012â€“ t_f t_f.alt â€“ changed the f terminal to be inline with all of the other f components\012\012\012\012\012# Cyrillic notes\012\012Differences between Text and Sans\012\012\012/H Text is 11 units narrower in Regular\012/H Text is 4 units narrower in Bold\012\012V -14\012\012/C Text is 49 narrower in Regular\012/C Text is  in Bold\012\012/P W -25 Regular\012/P W -32 Bold\012\012/n Text is 15 units narrower in Regular\012/n Text is 3 units narrower in Bold\012\012/n Text is 16 units taller in Regular\012/n Text is 16 units taller in Bold\012\012\012/h.sc\012M -31\012H -28\012\012Bold\012H -29\012M -14\012\012\012Regular\012F + 12 \012S + 30\012n h +16\012n w -15\012H w -11\012\012P w -25\012P RSB +4\012P oval +10\012\012H RSB +2\012n RSB + 10\012\012Bold\012S + 30\012n h +16\012n w -3\012H w -4\012H RSB +3\012P w -32\012P RSB +4\012P oval +11\012\012n RSB +9";
},
